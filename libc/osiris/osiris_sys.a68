**********************************************************
* osiris_sys.a68 --- c68k Osiris backend: crt0 (_start) + the libc syscall
* seam over Osiris DOS (TRAP #1), plus the sbrk heap that C malloc grows.
*
* Osiris loads a .PRG (ELF32-MSB static-PIE): the loader maps the segments,
* ZERO-FILLS .bss, applies the R_68K_RELATIVE relocs, and enters _start in
* USER MODE with  A0 = PSP,  A1 = PSP+$80 (command tail / DTA),  USP = a
* loader stack.  A program must terminate via DOS 4Ch; never rts from _start.
*
* Seam ABI is the ordinary c68k C stack convention (args on the stack, result
* in D0). Register use inside each TRAP follows dos-api.md: function selector
* AH in D0 high byte, handle in D1.W (BX), byte count in D2 (CX), buffer in A0.
**********************************************************
        .model  flat

        PUBLIC  _start
        PUBLIC  _sys_write,_sys_read,_sys_open,_sys_creat,_sys_close
        PUBLIC  _sys_seek,_sys_unlink,_sys_rename,_sys_exit,_sys_sbrk,_sys_heapavail
        PUBLIC  _sys_time,_sys_getenv,_sys_exec
        PUBLIC  _sys_dup,_sys_dup2,_sys_isatty,_sys_access
        PUBLIC  _sys_findfirst,_sys_findnext,_sys_getfiletime,_sys_setfiletime
        PUBLIC  _sys_mkdir,_sys_rmdir,_sys_chdir,_sys_getcwd,_sys_chmod,_sys_fdsize
        PUBLIC  _sys_setenv,_sys_getenvblk
        PUBLIC  _sys_conin,_sys_constat,_sys_doscall,_cpm_bdos
        PUBLIC  _sys_lasterror
        EXTERN  _main,_envbuild

* DOS TRAP #1 function selectors (AH, high byte of D0.W).
DOSF_EXIT    equ  $4C00
DOSF_CREATE  equ  $3C00
DOSF_OPEN    equ  $3D00
DOSF_CLOSE   equ  $3E00
DOSF_READ    equ  $3F00
DOSF_WRITE   equ  $4000
DOSF_UNLINK  equ  $4100
DOSF_RENAME  equ  $5600
DOSF_LSEEK   equ  $4200
DOSF_CHMOD   equ  $4300       ; 43h get/set attributes (AL 00=get -> D2 = attr)
DOSF_IOCTL   equ  $4400       ; 44h IOCTL (AL 00=get device info -> D3 = info word)
DOSF_DUP     equ  $4500       ; 45h duplicate handle (D1 -> D0)
DOSF_DUP2    equ  $4600       ; 46h force-duplicate handle / dup2 (D1,D2)
DOSF_SETDTA  equ  $1A00       ; 1Ah set Disk Transfer Area = A0
DOSF_CURDISK equ  $1900       ; 19h current drive -> AL (0=A)
DOSF_MKDIR   equ  $3900       ; 39h make directory (A0=path)
DOSF_RMDIR   equ  $3A00       ; 3Ah remove directory (A0=path)
DOSF_CHDIR   equ  $3B00       ; 3Bh change directory (A0=path)
DOSF_FFIRST  equ  $4E00       ; 4Eh find first (A0=path, D2=attr -> DTA)
DOSF_FNEXT   equ  $4F00       ; 4Fh find next (DTA)
DOSF_GETCWD  equ  $4700       ; 47h get current dir (A0=buf, D3=drive)
DOSF_FILETIME equ $5700       ; 57h get/set file date-time (D1=handle)
DOSF_ALLOC   equ  $4800
DOSF_GETDATE equ  $2A00
DOSF_GETTIME equ  $2C00
DOSF_ENVGET  equ  $6400       ; 64h env access, sub-fn 00 (GET): A0=name -> A0=value/0
DOSF_ENVSET  equ  $6401       ; 64h.01 SET: A0=name, A1=value (empty = delete)
DOSF_ENVGETBLK equ $6402      ; 64h.02 GETBLK: -> A0 = env block (0 = none)
DOSF_EXEC    equ  $4B00       ; 4Bh EXEC, mode 00 (load and execute a child to completion)
DOSF_GETRET  equ  $4D00       ; 4Dh get child return code -> D0 = (cause<<8)|code

STKSIZE      equ  $4000       ; 16 KiB user stack reserved at the arena top
HEAPSLOP     equ  $100
EXEC_RESERVE equ  $40000      ; leave up to 256 KiB free in DOS for system()/EXEC children
CHUNK        equ  32768       ; max bytes per DOS read/write (CX is 16-bit)

* Command-tail (argv) parsing.  The loader leaves the DOS-style tail in the
* PSP: a length byte at PSP+80h and the chars (CR-terminated) at PSP+81h.
PSP_CMDLEN   equ  $80         ; byte: command-tail length
PSP_CMDTAIL  equ  $81         ; command-tail characters
ARGVMAX      equ  32          ; argv[] slots (argv[0] + args + NULL terminator)
ARGBUFSZ     equ  128         ; mutable copy of the tail

        .code

**********************************************************
* _start --- Osiris entry (user mode). Claim the largest free block, put a
* fresh stack at its top and the C heap below, then call main; exit via 4Ch.
**********************************************************
_start:
        move.l  a0,c_psp            ; save PSP (bss already zeroed by loader)

        move.l  #$7FFFFFFF,d1       ; DOS 48h probe: ask for more than exists
        move.w  #DOSF_ALLOC,d0
        trap    #1                  ; fails -> carry set, D1 = largest free
        move.l  d1,d2
        ; Leave a capped pool free in DOS so system()/EXEC (4Bh) can load a child
        ; (the child image + its temp load buffer + stack + PSP).  reserve =
        ; min(EXEC_RESERVE, largest/4) -- scales down on tiny-memory configs so a
        ; small machine still runs, just with less room for a spawned command.
        move.l  d1,d5
        lsr.l   #2,d5              ; D5 = largest / 4
        cmpi.l  #EXEC_RESERVE,d5
        bls     start_resok
        move.l  #EXEC_RESERVE,d5   ; cap the reserve
start_resok:
        sub.l   d5,d2              ; claim (largest - reserve)
        subi.l  #HEAPSLOP,d2
        bls     start_nomem
        move.l  d2,d1
        move.w  #DOSF_ALLOC,d0
        trap    #1                  ; claim it -> A0 = block base
        bcs     start_nomem

        move.l  a0,d3               ; D3 = arena base
        move.l  d3,d4
        add.l   d2,d4               ; D4 = arena top
        movea.l d4,a7               ; USP = arena top (fresh user stack)
        move.l  d3,c_heapbase
        move.l  d3,c_brk
        move.l  d2,d0
        subi.l  #STKSIZE,d0         ; heap length = arena - reserved stack
        move.l  d0,c_heaplen

        jsr     _envbuild           ; build environ[] from the env block -> D0 = envp
        move.l  d0,-(sp)            ; main(argc, argv, envp)
        lea     c_argv,a0
        move.l  a0,-(sp)
        bsr     build_argv          ; parse the command tail -> c_argv[]; D0 = argc
        move.l  d0,-(sp)
        jsr     _main
        lea     12(sp),sp

        move.l  d0,-(sp)            ; exit(main's return code)
        jsr     _sys_exit
start_nomem:
        move.w  #DOSF_EXIT+1,d0     ; out of memory: terminate, non-zero code
        trap    #1
sn_spin:
        bra     sn_spin

**********************************************************
* build_argv --- tokenise the DOS command tail into the argv[] array.
* argv[0] is a placeholder program name; argv[1..] are the whitespace-
* delimited tail tokens; the array is NULL-terminated.  The tail is copied
* into c_argbuf so each token can be NUL-terminated in place.  Returns
* D0 = argc.  (Matches the cmdlib cl_args tokeniser: split on space/tab.)
**********************************************************
build_argv:
        movem.l d1-d4/a0-a3,-(sp)
        movea.l c_psp,a0            ; A0 = PSP
        moveq   #0,d1
        move.b  PSP_CMDLEN(a0),d1   ; D1 = tail length (0..127)
        cmpi.w  #ARGBUFSZ-1,d1
        bls     ba_lenok
        move.w  #ARGBUFSZ-1,d1      ; clamp to the buffer
ba_lenok:
        lea     PSP_CMDTAIL(a0),a1  ; A1 = tail chars (source)
        lea     c_argbuf,a2         ; A2 = mutable copy (dest)
        move.w  d1,d2
        bra     ba_ctest
ba_copy:
        move.b  (a1)+,(a2)+
        subq.w  #1,d2
ba_ctest:
        tst.w   d2
        bne     ba_copy
        clr.b   (a2)               ; NUL-terminate the copy

        lea     c_argv,a3          ; A3 = argv[] cursor
        lea     c_progname,a0
        move.l  a0,(a3)+           ; argv[0] = program-name placeholder
        moveq   #1,d3              ; D3 = argc = 1
        lea     c_argbuf,a2        ; A2 = scan cursor
ba_skip:
        move.b  (a2),d4
        beq     ba_end             ; NUL -> tail exhausted
        cmpi.b  #' ',d4
        beq     ba_wsp
        cmpi.b  #9,d4              ; tab
        beq     ba_wsp
        cmpi.b  #13,d4             ; CR (defensive; not normally copied)
        beq     ba_end
        bra     ba_token
ba_wsp:
        addq.l  #1,a2
        bra     ba_skip
ba_token:
        cmpi.w  #ARGVMAX-1,d3      ; leave a slot for the NULL terminator
        bhs     ba_end
        move.l  a2,(a3)+           ; argv[argc] = token start
        addq.w  #1,d3
ba_tchar:
        move.b  (a2),d4
        beq     ba_end             ; end of buffer -> last token
        cmpi.b  #' ',d4
        beq     ba_cut
        cmpi.b  #9,d4
        beq     ba_cut
        cmpi.b  #13,d4
        beq     ba_cut
        addq.l  #1,a2
        bra     ba_tchar
ba_cut:
        clr.b   (a2)+             ; terminate the token, step past the delimiter
        bra     ba_skip
ba_end:
        clr.l   (a3)              ; argv[argc] = NULL
        move.l  d3,d0             ; return argc
        movem.l (sp)+,d1-d4/a0-a3
        rts

**********************************************************
* void _sys_exit(int code) --- DOS 4Ch. Never returns.
**********************************************************
_sys_exit:
        move.l  4(sp),d0
        andi.w  #$FF,d0
        ori.w   #DOSF_EXIT,d0       ; D0.W = $4C00 | (code & FF)
        trap    #1
sx_spin:
        bra     sx_spin

**********************************************************
* int _sys_write(int fd, const void *buf, int n) -> bytes written.
**********************************************************
_sys_write:
        link    a6,#0
        movem.l d2-d5/a2,-(sp)
        move.l  8(a6),d5            ; fd (handle)
        movea.l 12(a6),a2          ; buf
        move.l  16(a6),d4          ; n
        moveq   #0,d3              ; total
sw_lp:
        tst.l   d4
        beq     sw_done
        move.l  d4,d2
        cmpi.l  #CHUNK,d2
        bls     sw_sz
        move.l  #CHUNK,d2
sw_sz:
        move.w  d5,d1              ; handle (BX)
        movea.l a2,a0
        adda.l  d3,a0              ; buf + total
        move.w  #DOSF_WRITE,d0
        trap    #1
        bcs     sw_done
        andi.l  #$FFFF,d0          ; bytes written this call
        add.l   d0,d3
        sub.l   d0,d4
        cmp.l   d0,d2              ; short write -> stop
        bne     sw_done
        bra     sw_lp
sw_done:
        move.l  d3,d0
        movem.l (sp)+,d2-d5/a2
        unlk    a6
        rts

**********************************************************
* int _sys_read(int fd, void *buf, int n) -> bytes read (0 = EOF).
**********************************************************
_sys_read:
        link    a6,#0
        movem.l d2-d5/a2,-(sp)
        move.l  8(a6),d5           ; fd
        movea.l 12(a6),a2         ; buf
        move.l  16(a6),d4         ; n
        moveq   #0,d3             ; total
sr_lp:
        tst.l   d4
        beq     sr_done
        move.l  d4,d2
        cmpi.l  #CHUNK,d2
        bls     sr_sz
        move.l  #CHUNK,d2
sr_sz:
        move.w  d5,d1
        movea.l a2,a0
        adda.l  d3,a0
        move.w  #DOSF_READ,d0
        trap    #1
        bcs     sr_done
        andi.l  #$FFFF,d0
        add.l   d0,d3
        sub.l   d0,d4
        tst.w   d0
        beq     sr_done           ; 0 bytes -> EOF
        cmp.l   d0,d2             ; short read -> EOF
        bne     sr_done
        bra     sr_lp
sr_done:
        move.l  d3,d0
        movem.l (sp)+,d2-d5/a2
        unlk    a6
        rts

**********************************************************
* int _sys_open(const char *path, int mode) -> handle, or -1.
**********************************************************
_sys_open:
        link    a6,#0
        movea.l 8(a6),a0
        move.l  12(a6),d0
        andi.w  #$FF,d0
        ori.w   #DOSF_OPEN,d0
        trap    #1
        bcs     so_err
        andi.l  #$FFFF,d0
        unlk    a6
        rts
so_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_creat(const char *path, int attr) -> handle, or -1.
**********************************************************
_sys_creat:
        link    a6,#0
        movea.l 8(a6),a0
        move.l  12(a6),d2          ; attr (CX)
        move.w  #DOSF_CREATE,d0
        trap    #1
        bcs     scr_err
        andi.l  #$FFFF,d0
        unlk    a6
        rts
scr_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_close(int fd) -> 0, or -1.
**********************************************************
_sys_close:
        link    a6,#0
        move.l  8(a6),d1
        move.w  #DOSF_CLOSE,d0
        trap    #1
        bcs     scl_err
        moveq   #0,d0
        unlk    a6
        rts
scl_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* long _sys_seek(int fd, long off, int whence) -> new position, or -1.
**********************************************************
_sys_seek:
        link    a6,#0
        move.l  8(a6),d1           ; handle
        move.l  12(a6),d3          ; offset
        move.l  16(a6),d0          ; whence (method)
        andi.w  #$FF,d0
        ori.w   #DOSF_LSEEK,d0
        trap    #1
        bcs     sk_err
        unlk    a6
        rts
sk_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_unlink(const char *path) -> 0, or -1.
**********************************************************
_sys_unlink:
        link    a6,#0
        movea.l 8(a6),a0
        move.w  #DOSF_UNLINK,d0
        trap    #1
        bcs     su_err
        moveq   #0,d0
        unlk    a6
        rts
su_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_rename(const char *oldp, const char *newp) -> 0, or -1.
* DOS 56h: A0 = old path, A1 = new path; carry set on error.
**********************************************************
_sys_rename:
        link    a6,#0
        movea.l 8(a6),a0            ; old path
        movea.l 12(a6),a1           ; new path
        move.w  #DOSF_RENAME,d0
        trap    #1
        bcs     sre_err
        moveq   #0,d0
        unlk    a6
        rts
sre_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_dup(int fd) -> new handle, or -1.
* DOS 45h: D1.W = handle -> D0.W = new handle; carry set on error.
**********************************************************
_sys_dup:
        link    a6,#0
        move.l  8(a6),d1           ; handle (BX)
        move.w  #DOSF_DUP,d0
        trap    #1
        bcs     dup_err
        andi.l  #$FFFF,d0          ; new handle
        unlk    a6
        rts
dup_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_dup2(int oldfd, int newfd) -> newfd, or -1.
* DOS 46h: D1.W = source handle, D2.W = target handle; carry set on error.
* On success the target handle is the result (POSIX dup2 semantics).
**********************************************************
_sys_dup2:
        link    a6,#0
        move.l  8(a6),d1           ; source handle (BX)
        move.l  12(a6),d2          ; target handle (CX)
        move.w  #DOSF_DUP2,d0
        trap    #1
        bcs     dup2_err
        move.l  12(a6),d0          ; success -> return the target handle
        unlk    a6
        rts
dup2_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_isatty(int fd) -> 1 if a console/char device, else 0.
* DOS 44h/00h (IOCTL get device info): D1.W = handle -> D3 = info word,
* bit 7 ($80) = ISDEV.  A bad handle (carry set) reports "not a tty".
**********************************************************
_sys_isatty:
        link    a6,#0
        move.l  8(a6),d1           ; handle (BX)
        move.w  #DOSF_IOCTL,d0     ; AL = 00 -> get device info in D3
        trap    #1
        bcs     itty_no
        move.l  d3,d0              ; device-info word (returned in D3)
        andi.l  #$80,d0            ; bit 7 set = character device
        beq     itty_no
        moveq   #1,d0
        unlk    a6
        rts
itty_no:
        moveq   #0,d0
        unlk    a6
        rts

**********************************************************
* int _sys_access(const char *path) -> DOS attribute word, or -1 if absent.
* DOS 43h/00h (get attributes): A0 = path -> D2 = attribute (bit 0 = read-only);
* carry set (file not found) -> -1.
**********************************************************
_sys_access:
        link    a6,#0
        movea.l 8(a6),a0           ; path
        move.w  #DOSF_CHMOD,d0     ; AL = 00 -> get attributes in D2
        trap    #1
        bcs     acc_err
        move.l  d2,d0              ; attribute word
        andi.l  #$FFFF,d0
        unlk    a6
        rts
acc_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_findfirst(const char *path, int attr, void *dta) -> 0, or -1.
* Point the DTA at the caller's find block (1Ah), then DOS 4Eh find-first
* (A0=path, D2=attr) fills it: attr@15h, time@16h, date@18h, size@1Ah, name@1Eh
* (multi-byte fields big-endian).
**********************************************************
_sys_findfirst:
        link    a6,#0
        movea.l 16(a6),a0          ; A0 = dta (find block)
        move.w  #DOSF_SETDTA,d0
        trap    #1
        movea.l 8(a6),a0           ; A0 = path
        move.l  12(a6),d2          ; D2 = attribute mask
        move.w  #DOSF_FFIRST,d0
        trap    #1
        bcs     ff_err
        moveq   #0,d0
        unlk    a6
        rts
ff_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_findnext(void *dta) -> 0, or -1.  Re-point the DTA at the caller's
* find block (1Ah), then continue the search (4Fh).
**********************************************************
_sys_findnext:
        link    a6,#0
        movea.l 8(a6),a0           ; A0 = dta (holds the opaque search state)
        move.w  #DOSF_SETDTA,d0
        trap    #1
        move.w  #DOSF_FNEXT,d0
        trap    #1
        bcs     fn_err
        moveq   #0,d0
        unlk    a6
        rts
fn_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_getfiletime(int fd) -> (date<<16)|time, or -1.
* DOS 57h/00: D1.W=handle -> D2=time, D3=date.
**********************************************************
_sys_getfiletime:
        link    a6,#0
        move.l  8(a6),d1           ; handle
        move.w  #DOSF_FILETIME,d0  ; AL = 00 (get)
        trap    #1
        bcs     gft_err
        moveq   #0,d0
        move.w  d3,d0              ; d0 = date
        swap    d0                 ; d0 = date << 16
        move.w  d2,d0              ; d0 = (date<<16) | time
        unlk    a6
        rts
gft_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_setfiletime(int fd, long dtstamp) -> 0, or -1.
* DOS 57h/01: D1.W=handle, D2.W=time, D3.W=date.  dtstamp = (date<<16)|time.
**********************************************************
_sys_setfiletime:
        link    a6,#0
        move.l  8(a6),d1           ; handle
        move.l  12(a6),d2          ; D2 = dtstamp (low word = time)
        move.l  d2,d3
        swap    d3                 ; D3 low word = date
        move.w  #DOSF_FILETIME+1,d0 ; AL = 01 (set)
        trap    #1
        bcs     stf_err
        moveq   #0,d0
        unlk    a6
        rts
stf_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_mkdir(const char *path) -> 0, or -1.  DOS 39h.
**********************************************************
_sys_mkdir:
        link    a6,#0
        movea.l 8(a6),a0
        move.w  #DOSF_MKDIR,d0
        trap    #1
        bcs     mkd_err
        moveq   #0,d0
        unlk    a6
        rts
mkd_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_rmdir(const char *path) -> 0, or -1.  DOS 3Ah.
**********************************************************
_sys_rmdir:
        link    a6,#0
        movea.l 8(a6),a0
        move.w  #DOSF_RMDIR,d0
        trap    #1
        bcs     rmd_err
        moveq   #0,d0
        unlk    a6
        rts
rmd_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_chdir(const char *path) -> 0, or -1.  DOS 3Bh.
**********************************************************
_sys_chdir:
        link    a6,#0
        movea.l 8(a6),a0
        move.w  #DOSF_CHDIR,d0
        trap    #1
        bcs     chd_err
        moveq   #0,d0
        unlk    a6
        rts
chd_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_getcwd(char *buf) -> 0.  Writes "X:\" (current drive via 19h) then
* the current directory path (47h fills buf+3; ASCIIZ, no leading backslash).
* A1 keeps buf across the traps (the DOS epilogue preserves A1-A6/D2-D7).
**********************************************************
_sys_getcwd:
        link    a6,#0
        movea.l 8(a6),a1           ; A1 = buf (survives the traps)
        move.w  #DOSF_CURDISK,d0   ; 19h -> D0.b = drive (0=A)
        trap    #1
        addi.b  #'A',d0
        move.b  d0,(a1)            ; buf[0] = drive letter
        move.b  #':',1(a1)         ; buf[1] = ':'
        move.b  #$5C,2(a1)         ; buf[2] = backslash
        lea     3(a1),a0           ; A0 = buf+3 (47h fills from here)
        moveq   #0,d3              ; D3 = 0 = default drive
        move.w  #DOSF_GETCWD,d0    ; 47h
        trap    #1
        moveq   #0,d0
        unlk    a6
        rts

**********************************************************
* int _sys_chmod(const char *path, int attr) -> 0, or -1.
* DOS 43h/01 set attributes: A0=path, D2=attr.
**********************************************************
_sys_chmod:
        link    a6,#0
        movea.l 8(a6),a0
        move.l  12(a6),d2          ; attribute
        move.w  #DOSF_CHMOD+1,d0   ; AL = 01 (set)
        trap    #1
        bcs     chm_err
        moveq   #0,d0
        unlk    a6
        rts
chm_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* long _sys_fdsize(int fd) -> file size in bytes, or -1.
* DOS 42h LSEEK method 2 (SEEK_END): returns the end position = size.  Moves
* the file pointer to end; fstat restores it afterwards.
**********************************************************
_sys_fdsize:
        link    a6,#0
        move.l  8(a6),d1           ; handle
        moveq   #0,d3              ; offset 0
        move.w  #DOSF_LSEEK+2,d0   ; method 2 = SEEK_END
        trap    #1
        bcs     fds_err
        unlk    a6
        rts
fds_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_conin(void) -> raw console char (no echo), blocking.  DOS 07h.
**********************************************************
_sys_conin:
        move.w  #$0700,d0
        trap    #1
        andi.l  #$FF,d0
        rts

**********************************************************
* int _sys_constat(void) -> 1 if a key is ready, else 0.  DOS 0Bh.
**********************************************************
_sys_constat:
        move.w  #$0B00,d0
        trap    #1
        andi.l  #$FF,d0            ; D0.b = FF ready / 00 none
        beq     cst_ret
        moveq   #1,d0
cst_ret:
        rts

**********************************************************
* long _sys_doscall(struct dosregs *r) -- generic DOS (TRAP #1) escape hatch.
* r = { u32 d0,d1,d2,d3; void *a0,*a1; long cflag } at offsets 0,4,8,12,16,20,24.
* Loads the registers from *r, traps, stores D0-D3/A0/A1 + the carry flag back,
* and returns r->d0.  A2 (struct ptr) and the caller's D2-D4 are preserved.
**********************************************************
_sys_doscall:
        link    a6,#0
        movem.l d2-d4/a2,-(sp)
        movea.l 8(a6),a2            ; A2 = struct (DOS preserves A2 across the trap)
        move.l  0(a2),d0
        move.l  4(a2),d1
        move.l  8(a2),d2
        move.l  12(a2),d3
        movea.l 16(a2),a0
        movea.l 20(a2),a1
        trap    #1
        bcc     dc_cc0             ; capture carry FIRST (before any CC-affecting op)
        moveq   #1,d4
        bra     dc_ccdone
dc_cc0:
        moveq   #0,d4
dc_ccdone:
        move.l  d0,0(a2)
        move.l  d1,4(a2)
        move.l  d2,8(a2)
        move.l  d3,12(a2)
        move.l  a0,16(a2)
        move.l  a1,20(a2)
        move.l  d4,24(a2)          ; cflag (0/1)
        move.l  0(a2),d0           ; return r->d0
        movem.l (sp)+,d2-d4/a2
        unlk    a6
        rts

**********************************************************
* long _cpm_bdos(int func, long param) -- CP/M BDOS is unavailable on Osiris.
* Present so <cpm.h> bdos() links on Osiris; it just fails.
**********************************************************
_cpm_bdos:
        moveq   #-1,d0
        rts

**********************************************************
* int _sys_lasterror(void) -> the last DOS extended error code (0 if none).
* DOS 59h (get extended error): D1 = version (ignored) -> D0.W = latched code.
**********************************************************
_sys_lasterror:
        moveq   #0,d1
        move.w  #$5900,d0
        trap    #1
        andi.l  #$FFFF,d0
        rts

**********************************************************
* void *_sys_sbrk(int delta) -> old break, or (void*)-1 on OOM.
**********************************************************
_sys_sbrk:
        link    a6,#0
        move.l  8(a6),d0           ; delta
        move.l  c_brk,d1           ; current break
        movea.l d1,a0              ; return = old break
        add.l   d0,d1              ; new break
        move.l  c_heapbase,d0
        cmp.l   d0,d1
        bcs     sbrk_err           ; new < base
        add.l   c_heaplen,d0       ; heap top
        cmp.l   d0,d1
        bhi     sbrk_err           ; new > top
        move.l  d1,c_brk
        move.l  a0,d0              ; old break
        unlk    a6
        rts
sbrk_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* int _sys_heapavail(void) -> bytes between the break and the arena top.
* Used by the default libheap-backed malloc to size the machine
* heap over the sbrk arena the crt0 reserved.
**********************************************************
_sys_heapavail:
        lea     c_heapbase,a0      ; a0 -> [c_heapbase, c_heaplen, c_brk]
        move.l  (a0),d0            ; c_heapbase
        add.l   4(a0),d0           ; + c_heaplen = arena top
        sub.l   8(a0),d0           ; - c_brk = bytes available
        rts

**********************************************************
* int _sys_time(struct __sysdt *dt) --- read the DOS wall clock into the
* caller's broken-down struct (6 longs: +0 year +4 mon +8 mday +12 hour
* +16 min +20 sec) using 2Ah (get date) + 2Ch (get time). The DOS clock is
* always readable, so this returns 0.  The frame pointer A6 survives the
* traps, so we reload the struct pointer from 8(a6) after each call.
**********************************************************
_sys_time:
        link    a6,#0
        move.w  #DOSF_GETDATE,d0   ; 2Ah -> D1.L=year, D2.w=(mon<<8)|day
        trap    #1
        movea.l 8(a6),a0
        move.l  d1,(a0)            ; year (full)
        move.w  d2,d1
        andi.l  #$FF,d1
        move.l  d1,8(a0)           ; mday = D2 & $FF
        move.w  d2,d1
        lsr.w   #8,d1
        andi.l  #$FF,d1
        move.l  d1,4(a0)           ; mon = D2 >> 8
        move.w  #DOSF_GETTIME,d0   ; 2Ch -> D2.w=(hr<<8)|min, D3.w=(sec<<8)|cs
        trap    #1
        movea.l 8(a6),a0
        move.w  d2,d1
        lsr.w   #8,d1
        andi.l  #$FF,d1
        move.l  d1,12(a0)          ; hour = D2 >> 8
        move.w  d2,d1
        andi.l  #$FF,d1
        move.l  d1,16(a0)          ; min = D2 & $FF
        move.w  d3,d1
        lsr.w   #8,d1
        andi.l  #$FF,d1
        move.l  d1,20(a0)          ; sec = D3 >> 8
        moveq   #0,d0              ; success
        unlk    a6
        rts

**********************************************************
* char *_sys_getenv(const char *name) -> value pointer, or NULL if absent.
* Osiris 64h GET (D0.W = $6400): A0 = name (ASCIIZ) -> A0 = value / 0.  GET has
* no error return -- an unknown name comes back as A0 = 0 (carry clear).  The
* value points into the process's environment block, which lives for the run,
* so returning it directly satisfies getenv's "must not be modified / may be
* overwritten by a later call" contract.
**********************************************************
_sys_getenv:
        link    a6,#0
        movea.l 8(a6),a0            ; name (ASCIIZ)
        move.w  #DOSF_ENVGET,d0     ; 64h sub-fn 00 = GET
        trap    #1
        move.l  a0,d0              ; A0 = value ptr (0 = absent) -> return in D0
        unlk    a6
        rts

**********************************************************
* int _sys_setenv(const char *name, const char *value) -> 0, or -1.
* Osiris 64h.01 SET: A0 = name, A1 = value (empty string = delete).  The kernel
* REBUILDS the process environment block (so cached pointers into it -- e.g.
* environ[] -- must be refreshed afterwards) and updates PSP+30h.
**********************************************************
_sys_setenv:
        link    a6,#0
        movea.l 8(a6),a0            ; name
        movea.l 12(a6),a1           ; value (ASCIIZ; empty = delete)
        move.w  #DOSF_ENVSET,d0     ; 64h sub-fn 01 = SET
        trap    #1
        bcs     sev_err
        moveq   #0,d0
        unlk    a6
        rts
sev_err:
        moveq   #-1,d0
        unlk    a6
        rts

**********************************************************
* char *_sys_getenvblk(void) -> the current environment block, or NULL.
* Osiris 64h.02 GETBLK: -> A0 = block (a run of "NAME=VALUE" ASCIIZ strings
* ending in an empty string).  No error return.
**********************************************************
_sys_getenvblk:
        move.w  #DOSF_ENVGETBLK,d0  ; 64h sub-fn 02 = GETBLK
        trap    #1
        move.l  a0,d0              ; A0 = block ptr (0 = none) -> return in D0
        rts

**********************************************************
* int _sys_exec(const char *path, void *parmblk) --- run a child to completion.
* DOS 4Bh mode 00h loads + relocates the .PRG at A0, builds its PSP from the
* EXEC parameter block at A1 (command tail + inherited environment), and runs it
* in user mode; control returns here after the child's 4Ch.  4Dh then reads the
* child's return code (D0 = (cause<<8)|code).  system() passes path = COMSPEC and
* a "/C <command>" tail.  -> D0 = child exit code (0..255), or -1 if EXEC failed
* (file not found / out of memory: carry set).
**********************************************************
_sys_exec:
        link    a6,#0
        movea.l 8(a6),a0            ; path (the command processor, COMSPEC)
        movea.l 12(a6),a1           ; EXEC parameter block
        move.w  #DOSF_EXEC,d0       ; 4B00 = load and execute
        trap    #1
        bcs     sex_err             ; EXEC itself failed -> -1
        move.w  #DOSF_GETRET,d0     ; 4D00 = get the child's return code
        trap    #1
        andi.l  #$FF,d0            ; low byte = exit code (drop the cause byte)
        unlk    a6
        rts
sex_err:
        moveq   #-1,d0
        unlk    a6
        rts

        .data
c_progname  dc.b  'PROG',0
        ALIGN 2
c_envp      dc.l  0                 ; envp[0] = NULL

        .bss
c_psp       ds.l  1
c_heapbase  ds.l  1
c_heaplen   ds.l  1
c_brk       ds.l  1
c_argv      ds.l  ARGVMAX           ; argv[] built from the command tail
c_argbuf    ds.b  ARGBUFSZ          ; mutable copy of the command tail

        end
