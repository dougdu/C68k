	title	"IEEE 754 single-precision fused multiply-add"
; ============================================================
;  _fma / _fmaf -- correctly-rounded single-precision FMA
;
;  float _fma(float a, float b, float c)  ->  round(a*b + c)  (single RNE)
;  Arguments: 8(a6)=a, 12(a6)=b, 16(a6)=c.  Result in D0.
;
;  Exact a*b + c with ONE rounding (round-to-nearest-even).  The 48-bit
;  product and the 24-bit c are placed into a 96-bit signed accumulator
;  anchored at the larger operand's MSB; bits that fall below the window
;  become a sticky bit.  The signed sum is normalised and rounded once.
;  Policy: D3 gradual underflow -- subnormal *inputs* are decomposed with
;  Ce=-149 (no implied bit); a subnormal *result* is denormalised and
;  round-nearest-even on the subnormal grid; overflow -> +/-inf.
;
;  Modelled + validated in test/tools/fma_model.py before this asm.
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fmaf
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

_fmaf:
	link	a6,#0
	movem.l	d2-d7,-(sp)
	move.l	8(a6),d2		; a
	move.l	12(a6),d3		; b
	move.l	16(a6),d4		; c

	; ---- NaN in any operand -> qNaN ----
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0
	cmpi.l	#SNG_INF,d0
	bhi	_fma_nan
	move.l	d3,d0
	andi.l	#$7FFFFFFF,d0
	cmpi.l	#SNG_INF,d0
	bhi	_fma_nan
	; NOTE: c-NaN is handled AFTER the 0*inf / inf*0 product check below --
	; those signal INVALID even when the addend c is a NaN (IEEE 754-2008 7.2).

	; ---- product sign ----
	move.l	d2,d5
	eor.l	d3,d5
	andi.l	#$80000000,d5		; d5 = psign

	; ---- special: 0*inf, inf products, product zero ----
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0		; |a|
	move.l	d3,d1
	andi.l	#$7FFFFFFF,d1		; |b|
	tst.l	d0
	bne.s	_fma_a_nz
	; a == 0
	cmpi.l	#SNG_INF,d1
	beq	_fma_invalid		; 0 * inf -> NaN (INVALID)
	bra	_fma_prod_zero		; 0 * finite -> product zero
_fma_a_nz:
	cmpi.l	#SNG_INF,d0
	bne.s	_fma_a_fin
	; a == inf (b nonzero here)
	tst.l	d1
	beq	_fma_invalid		; inf * 0 -> NaN (INVALID)
	bra.s	_fma_prod_inf
_fma_a_fin:
	cmpi.l	#SNG_INF,d1
	beq.s	_fma_prod_inf		; finite * inf -> inf
	tst.l	d1
	beq	_fma_prod_zero		; finite * 0 -> product zero
	; both finite nonzero: check c inf, else compute
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	cmpi.l	#SNG_INF,d0
	bhi	_fma_nan		; c is NaN -> propagate
	beq	_fma_ret_c		; finite product + inf c -> c
	bra	_fma_core

_fma_prod_inf:
	; product is +/-inf (psign in d5).  c NaN -> propagate; c = -inf(opposite)
	; -> NaN+INVALID; else psign|inf
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	cmpi.l	#SNG_INF,d0
	bhi	_fma_nan		; c is NaN -> propagate (no invalid)
	bne.s	_fma_ret_pinf
	move.l	d4,d0
	andi.l	#$80000000,d0		; c sign
	cmp.l	d5,d0
	bne	_fma_invalid		; opposite-sign inf -> NaN (INVALID)
_fma_ret_pinf:
	move.l	d5,d0
	ori.l	#SNG_INF,d0
	bra	_fma_ret
_fma_prod_zero:
	; product is +/-0.  c != 0 -> c; else signed-zero (-0 iff psign & c sign)
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	bne	_fma_ret_c
	move.l	d4,d0
	andi.l	#$80000000,d0
	and.l	d5,d0			; -0 iff both product and c negative
	bra	_fma_ret
_fma_ret_c:
	move.l	d4,d0
	bra	_fma_ret
_fma_invalid:
	ori.l	#FE_INVALID,_fe_status	; 0*inf / inf*0 / inf-inf -> INVALID
_fma_nan:
	move.l	#SNG_QNAN,d0
	bra	_fma_ret

; ---------------- finite nonzero product + finite c ----------------
_fma_core:
	; --- decompose a (d2), b (d3); subnormal (exp field 0) -> no implied bit,
	;     effective biased exponent 1 (D3; the wide accumulator normalises at end) ---
	move.l	d2,d0
	andi.l	#$007FFFFF,d0
	move.l	d2,d1
	andi.l	#$7F800000,d1
	bne.s	_fma_a_norm
	move.l	d0,fma_ma		; subnormal a
	moveq	#1,d1
	move.l	d1,fma_ea
	bra.s	_fma_a_done
_fma_a_norm:
	ori.l	#$00800000,d0
	move.l	d0,fma_ma
	move.l	d2,d0
	lsr.l	#8,d0
	lsr.l	#8,d0
	lsr.l	#7,d0
	andi.l	#$FF,d0
	move.l	d0,fma_ea		; Ea (biased)
_fma_a_done:
	move.l	d3,d0
	andi.l	#$007FFFFF,d0
	move.l	d3,d1
	andi.l	#$7F800000,d1
	bne.s	_fma_b_norm
	move.l	d0,fma_mb		; subnormal b
	moveq	#1,d1
	move.l	d1,fma_eb
	bra.s	_fma_b_done
_fma_b_norm:
	ori.l	#$00800000,d0
	move.l	d0,fma_mb
	move.l	d3,d0
	lsr.l	#8,d0
	lsr.l	#8,d0
	lsr.l	#7,d0
	andi.l	#$FF,d0
	move.l	d0,fma_eb
_fma_b_done:
	move.l	d5,fma_sp		; product sign
	; --- decompose c (d4): may be +/-0 ---
	move.l	d4,d0
	andi.l	#$80000000,d0
	move.l	d0,fma_sc
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	bne.s	_fma_c_norm
	clr.l	fma_mc			; c == 0 -> Mc = 0
	move.l	#$C0000000,fma_ce	; CE very negative so it never anchors
	bra.s	_fma_have_c
_fma_c_norm:
	move.l	d4,d0
	andi.l	#$007FFFFF,d0
	move.l	d4,d1
	andi.l	#$7F800000,d1
	bne.s	_fma_c_normal
	move.l	d0,fma_mc		; subnormal c: no implied bit
	move.l	#-149,fma_ce		; ce = 1 - 150
	bra.s	_fma_have_c
_fma_c_normal:
	ori.l	#$00800000,d0
	move.l	d0,fma_mc
	move.l	d4,d0
	lsr.l	#8,d0
	lsr.l	#8,d0
	lsr.l	#7,d0
	andi.l	#$FF,d0
	subi.l	#150,d0			; ce = Ec - 150
	move.l	d0,fma_ce
_fma_have_c:
	; --- PE = Ea + Eb - 300 ---
	move.l	fma_ea,d0
	add.l	fma_eb,d0
	subi.l	#300,d0
	move.l	d0,fma_pe
	; --- product P = Ma*Mb (48-bit) -> Phi:Plo ---
	move.l	fma_ma,d0
	move.l	d0,d1
	andi.l	#$FFFF,d1		; MaL
	lsr.l	#8,d0
	lsr.l	#8,d0			; MaH (8-bit)
	move.l	fma_mb,d2
	move.l	d2,d3
	andi.l	#$FFFF,d3		; MbL
	lsr.l	#8,d2
	lsr.l	#8,d2			; MbH
	move.l	d1,d4
	mulu	d3,d4			; MaL*MbL
	move.l	d0,d5
	mulu	d2,d5			; MaH*MbH
	move.l	d0,d6
	mulu	d3,d6			; MaH*MbL
	move.l	d1,d7
	mulu	d2,d7			; MaL*MbH
	add.l	d7,d6			; cross = MaH*MbL + MaL*MbH
	move.l	d6,d7
	swap	d7			; d7: hi=cross&FFFF, lo=cross>>16
	move.l	d7,d1
	clr.w	d1			; (cross&FFFF) << 16
	add.l	d1,d4			; Plo = MaL*MbL + (cross_lo<<16)
	moveq	#0,d1
	move.w	d7,d1			; cross >> 16
	addx.l	d1,d5			; Phi = MaH*MbH + (cross>>16) + carry
	move.l	d4,fma_plo
	move.l	d5,fma_phi
	; --- anchor A = max(PE+47, CE+23) + 2 ; lsbe = A - 95 ---
	move.l	fma_pe,d0
	addi.l	#47,d0			; pmsb
	move.l	fma_ce,d1
	addi.l	#23,d1			; cmsb
	cmp.l	d1,d0
	bge.s	_fma_amax
	move.l	d1,d0
_fma_amax:
	addi.l	#2,d0
	subi.l	#95,d0
	move.l	d0,fma_lsbe
	; --- init accumulator + sticky ---
	clr.l	fma_acc2
	clr.l	fma_acc1
	clr.l	fma_acc0
	clr.l	fma_stky
	clr.l	fma_lost
	; --- place product, add/sub by sp ---
	move.l	fma_phi,d0
	move.l	fma_plo,d1
	move.l	fma_pe,d2
	sub.l	fma_lsbe,d2
	bsr	_fma_place
	tst.l	fma_sp
	bne.s	_fma_p_sub
	bsr	_fma_acc_add
	tst.l	fma_llost
	beq.s	_fma_place_c
	move.l	#1,fma_lost
	clr.l	fma_lsgn		; product lost bits added -> +remainder
	bra.s	_fma_place_c
_fma_p_sub:
	bsr	_fma_acc_sub
	tst.l	fma_llost
	beq.s	_fma_place_c
	move.l	#1,fma_lost
	move.l	#1,fma_lsgn		; product lost bits subtracted -> -remainder
_fma_place_c:
	; --- place c, add/sub by sc ---
	moveq	#0,d0
	move.l	fma_mc,d1
	move.l	fma_ce,d2
	sub.l	fma_lsbe,d2
	bsr	_fma_place
	tst.l	fma_sc
	bne.s	_fma_c_sub
	bsr	_fma_acc_add
	tst.l	fma_llost
	beq.s	_fma_reduce
	move.l	#1,fma_lost
	clr.l	fma_lsgn		; c lost bits added -> +remainder
	bra.s	_fma_reduce
_fma_c_sub:
	bsr	_fma_acc_sub
	tst.l	fma_llost
	beq.s	_fma_reduce
	move.l	#1,fma_lost
	move.l	#1,fma_lsgn		; c lost bits subtracted -> -remainder

_fma_reduce:
	; --- sign of the accumulator; take magnitude ---
	move.l	fma_acc2,d0
	bpl.s	_fma_pos
	move.l	fma_acc0,d0
	neg.l	d0
	move.l	d0,fma_acc0
	move.l	fma_acc1,d0
	negx.l	d0
	move.l	d0,fma_acc1
	move.l	fma_acc2,d0
	negx.l	d0
	move.l	d0,fma_acc2
	moveq	#1,d7			; d7 = result sign (1 = negative)
	bra.s	_fma_chkz
_fma_pos:
	moveq	#0,d7
_fma_chkz:
	move.l	fma_acc2,d0
	or.l	fma_acc1,d0
	or.l	fma_acc0,d0
	beq	_fma_zero		; exact cancellation -> +0
	; --- fold the signed sub-LSB lost remainder S (|S| < 1 acc LSB) ---
	;   S same sign as magnitude -> tail is +|S| -> sticky only
	;   S opposite sign          -> tail is -|S| -> borrow 1 from mag + sticky
	; (only the SMALLER, far operand ever loses bits, so a single signed
	;  remainder suffices; the borrow is what turns a false product-midpoint
	;  tie into the correct round-down.)
	tst.l	fma_lost
	beq.s	_fma_nolost
	move.l	#1,fma_stky		; lost low bits => inexact => sticky
	move.l	fma_lsgn,d0
	cmp.l	d7,d0
	beq.s	_fma_nolost		; same sign -> sticky already set
	moveq	#0,d1			; opposite sign -> 96-bit magnitude -= 1
	move.l	fma_acc0,d0
	subq.l	#1,d0
	move.l	d0,fma_acc0
	move.l	fma_acc1,d0
	subx.l	d1,d0
	move.l	d0,fma_acc1
	move.l	fma_acc2,d0
	subx.l	d1,d0
	move.l	d0,fma_acc2
_fma_nolost:
	; --- normalise: shift left until acc2 bit31 set, count nsh in d6 ---
	moveq	#0,d6
_fma_nloop:
	move.l	fma_acc2,d0
	bmi.s	_fma_normed
	move.l	fma_acc0,d0
	add.l	d0,d0
	move.l	d0,fma_acc0
	move.l	fma_acc1,d0
	addx.l	d0,d0
	move.l	d0,fma_acc1
	move.l	fma_acc2,d0
	addx.l	d0,d0
	move.l	d0,fma_acc2
	addq.l	#1,d6
	bra.s	_fma_nloop
_fma_normed:
	; E = lsbe + 95 - nsh
	move.l	fma_lsbe,d5
	addi.l	#95,d5
	sub.l	d6,d5			; d5 = E
	cmpi.l	#127,d5
	bgt	_fma_ovf
	cmpi.l	#-126,d5
	blt	_fma_subnormal		; D3 gradual underflow
	; --- normal extract + RNE round ---
	move.l	fma_acc2,d1
	move.l	d1,d0
	lsr.l	#8,d0			; d0 = sig (24-bit)
	move.l	d1,d2
	andi.l	#$80,d2			; guard bit
	andi.l	#$7F,d1
	or.l	fma_acc1,d1
	or.l	fma_acc0,d1
	or.l	fma_stky,d1		; d1 != 0 -> sticky
	; D1: INEXACT iff guard OR sticky nonzero
	move.l	d1,d3
	or.l	d2,d3
	beq.s	_fma_rdec
	ori.l	#FE_INEXACT,_fe_status
	tst.l	_fe_round
	bne	_fma_rdir		; D4 directed rounding
_fma_rdec:
	tst.l	d2
	beq.s	_fma_pack		; guard 0
	tst.l	d1
	bne.s	_fma_pack_up		; sticky -> up
	btst	#0,d0
	beq.s	_fma_pack		; tie, even -> keep
_fma_pack_up:
	addq.l	#1,d0
	cmpi.l	#$01000000,d0
	bne.s	_fma_pack
	lsr.l	#1,d0			; carry out: 2^24 -> 2^23, E++
	addq.l	#1,d5
	cmpi.l	#127,d5
	bgt	_fma_ovf
_fma_pack:
	addi.l	#127,d5			; biased exponent
	lsl.l	#8,d5
	lsl.l	#8,d5
	lsl.l	#7,d5			; << 23
	andi.l	#$007FFFFF,d0		; drop implicit bit
	or.l	d0,d5
	tst.l	d7
	beq.s	_fma_setres
	ori.l	#$80000000,d5
_fma_setres:
	move.l	d5,d0
	bra	_fma_ret

_fma_rdir:
	; D4 directed normal round: inexact, sig d0, sign d7 (0/1).
	movem.l	d0,-(sp)		; save sig (movem preserves CCR on restore)
	move.l	d7,d1
	ror.l	#1,d1			; sign (0/1) -> bit31
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = round-up
	tst.l	d0
	movem.l	(sp)+,d0		; restore sig (CCR unchanged)
	beq	_fma_pack
	bra	_fma_pack_up

_fma_subnormal:
	; D3: E < -126.  Shift the 96-bit accumulator right by k = -126 - E, then
	; extract at the standard (>>8) position with exp field 0; round RNE (a
	; round-up may promote to the min normal, exp field 1).
	moveq	#-126,d0
	sub.l	d5,d0			; d0 = k (>= 1)
	cmpi.l	#26,d0			; below 1/2 ULP of the min subnormal -> +/-0
	bge	_fma_unf
	move.l	d0,d6			; shift counter
_fma_sub_shl:
	move.l	fma_acc2,d0
	move.l	fma_acc1,d1
	move.l	fma_acc0,d2
	btst	#0,d2			; a bit shifted off the bottom -> sticky
	beq.s	_fma_sub_nos
	ori.l	#1,fma_stky
_fma_sub_nos:
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d2
	move.l	d0,fma_acc2
	move.l	d1,fma_acc1
	move.l	d2,fma_acc0
	subq.l	#1,d6
	bne.s	_fma_sub_shl
	move.l	fma_acc2,d1
	move.l	d1,d0
	lsr.l	#8,d0			; sig (bit 23 clear = subnormal)
	move.l	d1,d2
	andi.l	#$80,d2			; guard
	andi.l	#$7F,d1
	or.l	fma_acc1,d1
	or.l	fma_acc0,d1
	or.l	fma_stky,d1		; sticky
	; D1: tininess-before -> subnormal path + inexact = UNDERFLOW+INEXACT
	move.l	d1,d3
	or.l	d2,d3
	beq.s	_fma_sub_rdec
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status
	tst.l	_fe_round
	bne	_fma_sub_dir		; D4 directed rounding
_fma_sub_rdec:
	tst.l	d2
	beq.s	_fma_sub_pack
	tst.l	d1
	bne.s	_fma_sub_up
	btst	#0,d0
	beq.s	_fma_sub_pack
_fma_sub_up:
	addq.l	#1,d0
_fma_sub_pack:
	btst	#23,d0			; carried up to the min normal?
	beq.s	_fma_sub_store
	andi.l	#$007FFFFF,d0
	ori.l	#$00800000,d0		; min normal (exp field 1)
	bra.s	_fma_sub_sign
_fma_sub_store:
	andi.l	#$007FFFFF,d0		; subnormal (exp field 0)
_fma_sub_sign:
	tst.l	d7
	beq.s	_fma_setres2
	ori.l	#$80000000,d0
_fma_setres2:
	bra	_fma_ret

_fma_sub_dir:
	; D4 directed subnormal round: inexact, sig d0, sign d7 (0/1).
	movem.l	d0,-(sp)
	move.l	d7,d1
	ror.l	#1,d1			; sign -> bit31
	moveq	#1,d0			; inexact
	bsr	_fe_dirup
	tst.l	d0
	movem.l	(sp)+,d0
	beq	_fma_sub_pack
	bra	_fma_sub_up

_fma_ovf:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status
	move.l	d7,d1
	ror.l	#1,d1			; sign -> bit31
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf
	tst.l	d0
	bne.s	_fma_ovf_max
	move.l	#SNG_INF,d0
	bra.s	_fma_ovf_sign
_fma_ovf_max:
	move.l	#$7F7FFFFF,d0		; directed toward 0 -> max-finite
_fma_ovf_sign:
	tst.l	d7
	beq.s	_fma_ret
	ori.l	#$80000000,d0
	bra.s	_fma_ret
_fma_unf:
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status
	move.l	d7,d1
	ror.l	#1,d1			; sign -> bit31
	moveq	#1,d0			; inexact (tiny nonzero)
	bsr	_fe_dirup		; RU-of-pos / RD-of-neg -> up to min subnormal
	tst.l	d0
	bne.s	_fma_unf_min
	moveq	#0,d0			; signed zero
	tst.l	d7
	beq.s	_fma_ret
	move.l	#$80000000,d0
	bra.s	_fma_ret
_fma_unf_min:
	moveq	#1,d0			; min subnormal magnitude
	tst.l	d7
	beq.s	_fma_ret
	ori.l	#$80000000,d0
	bra.s	_fma_ret
_fma_zero:
	moveq	#0,d0			; exact cancellation -> +0
_fma_ret:
	movem.l	(sp)+,d2-d7
	unlk	a6
	rts

; ------------------------------------------------------------
;  _fma_place -- place M (d0=hi, d1=lo, <=48 bits) at signed shift d2 into
;  fma_tp2:tp1:tp0 (96-bit).  Sets fma_llost=1 if any operand bit was lost
;  below the window (the caller folds that into sticky/borrow by sign).
;  Clobbers d0-d3.
; ------------------------------------------------------------
_fma_place:
	clr.l	fma_llost
	clr.l	fma_tp2
	clr.l	fma_tp1
	clr.l	fma_tp0
	tst.l	d2
	bmi.s	_fmp_right
	move.l	d0,fma_tp1
	move.l	d1,fma_tp0
	tst.l	d2
	beq.s	_fmp_ret
_fmp_lloop:
	move.l	fma_tp0,d3
	add.l	d3,d3
	move.l	d3,fma_tp0
	move.l	fma_tp1,d3
	addx.l	d3,d3
	move.l	d3,fma_tp1
	move.l	fma_tp2,d3
	addx.l	d3,d3
	move.l	d3,fma_tp2
	subq.l	#1,d2
	bne.s	_fmp_lloop
	rts
_fmp_right:
	neg.l	d2			; n = -shift
	cmpi.l	#48,d2
	bcc.s	_fmp_allst		; n >= 48 -> entire operand is sticky
	move.l	d1,fma_tp0
	move.l	d0,fma_tp1
_fmp_rloop:
	move.l	fma_tp1,d3
	lsr.l	#1,d3
	move.l	d3,fma_tp1
	move.l	fma_tp0,d3
	roxr.l	#1,d3
	bcc.s	_fmp_rnc		; test C BEFORE the store clobbers it
	moveq	#1,d0
	move.l	d0,fma_llost
_fmp_rnc:
	move.l	d3,fma_tp0
	subq.l	#1,d2
	bne.s	_fmp_rloop
_fmp_ret:
	rts
_fmp_allst:
	move.l	d0,d3
	or.l	d1,d3
	beq.s	_fmp_ret
	moveq	#1,d3
	move.l	d3,fma_llost
	rts

; ------------------------------------------------------------
;  _fma_acc_add / _fma_acc_sub -- acc(96) +=/-= tp(96).  Clobbers d0,d1.
; ------------------------------------------------------------
_fma_acc_add:
	move.l	fma_acc0,d0
	move.l	fma_tp0,d1
	add.l	d1,d0
	move.l	d0,fma_acc0
	move.l	fma_acc1,d0
	move.l	fma_tp1,d1
	addx.l	d1,d0
	move.l	d0,fma_acc1
	move.l	fma_acc2,d0
	move.l	fma_tp2,d1
	addx.l	d1,d0
	move.l	d0,fma_acc2
	rts
_fma_acc_sub:
	move.l	fma_acc0,d0
	move.l	fma_tp0,d1
	sub.l	d1,d0
	move.l	d0,fma_acc0
	move.l	fma_acc1,d0
	move.l	fma_tp1,d1
	subx.l	d1,d0
	move.l	d0,fma_acc1
	move.l	fma_acc2,d0
	move.l	fma_tp2,d1
	subx.l	d1,d0
	move.l	d0,fma_acc2
	rts

	.bss
fma_acc2	ds.l	1
fma_acc1	ds.l	1
fma_acc0	ds.l	1
fma_tp2		ds.l	1
fma_tp1		ds.l	1
fma_tp0		ds.l	1
fma_stky	ds.l	1
fma_llost	ds.l	1
fma_lost	ds.l	1
fma_lsgn	ds.l	1
fma_lsbe	ds.l	1
fma_ma		ds.l	1
fma_mb		ds.l	1
fma_mc		ds.l	1
fma_ea		ds.l	1
fma_eb		ds.l	1
fma_ce		ds.l	1
fma_pe		ds.l	1
fma_sp		ds.l	1
fma_sc		ds.l	1
fma_phi		ds.l	1
fma_plo		ds.l	1

	end
