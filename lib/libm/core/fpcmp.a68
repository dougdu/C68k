	title	"IEEE 754 single-precision comparison"
; ============================================================
;  _fpcmp / _fpcmpf — compare two single-precision floats
;
;  void _fpcmp(float dest, float src)
;  Sets CCR flags as if (dest - src):
;    N = dest < src
;    Z = dest == src
;    V = 1 when a NaN operand makes the compare UNORDERED (also D0 = 2); the
;        ordered paths always leave V = 0, so a caller can BVS to an unordered
;        handler before the ordered BEQ/BNE/BGT/BLT branches (delta D9).
;
;  Arguments: 4(SP)=dest, 8(SP)=src
;
;  Uses the IEEE float ordering property:
;  - Positive floats: bit pattern order = numeric order
;  - Negative floats: bit pattern order is reversed
;  - ±0 must be treated as equal
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpcmp, _fpcmpf

	.code

_fpcmp:
_fpcmpf:
	movem.l	d2-d3,-(sp)		; save scratch
	move.l	12(sp),d0		; d0 = dest (adjusted for saved regs)
	move.l	16(sp),d1		; d1 = src

	; --- NaN in either operand?  comparison is UNORDERED (delta D9) ---
	; A NaN has |x| > +inf bits.  Signal unordered instead of a bogus verdict.
	move.l	d0,d2
	andi.l	#$7FFFFFFF,d2
	cmpi.l	#SNG_INF,d2
	bhi.s	_cmp_unordered
	move.l	d1,d2
	andi.l	#$7FFFFFFF,d2
	cmpi.l	#SNG_INF,d2
	bhi.s	_cmp_unordered

	; --- Both zero? (±0 == ±0) ---
	move.l	d0,d2
	andi.l	#$7FFFFFFF,d2		; |dest|
	move.l	d1,d3
	andi.l	#$7FFFFFFF,d3		; |src|
	or.l	d3,d2			; |dest| | |src|
	bne.s	_cmp_nonzero
	; Both zero → equal
	movem.l	(sp)+,d2-d3
	moveq	#0,d0
	tst.l	d0			; Z=1
	rts

_cmp_nonzero:
	; --- Same sign? ---
	move.l	d0,d2
	eor.l	d1,d2
	btst.l	#31,d2
	bne.s	_cmp_diff_sign

	; --- Same sign ---
	btst.l	#31,d0			; both positive?
	bne.s	_cmp_both_neg

	; Both positive: larger bit pattern = larger value
	movem.l	(sp)+,d2-d3
	cmp.l	d1,d0			; dest - src
	rts

_cmp_both_neg:
	; Both negative: larger bit pattern = MORE negative = SMALLER
	movem.l	(sp)+,d2-d3
	cmp.l	d0,d1			; src - dest (reversed)
	rts

_cmp_diff_sign:
	; Different signs (and not both zero) => the operands are UNEQUAL, so Z must
	; be 0; the negative one is the smaller.  The old `tst.l d0` set Z=1 whenever
	; dest was +0 (e.g. `0.0f <= x`, which is how `x >= 0.0f` compiles), wrongly
	; reporting "equal" and breaking every `>=`/`<=`/`==` of a float against a
	; zero literal on the left.  Set N (dest<src) from dest's sign, Z always 0.
	movem.l	(sp)+,d2-d3		; (movem does not affect CCR)
	btst.l	#31,d0			; is dest the negative (smaller) operand?
	bne.s	_cmp_ds_dest_neg
	moveq	#1,d0			; dest >= +0 > src  => dest > src  (N=0, Z=0)
	rts
_cmp_ds_dest_neg:
	moveq	#-1,d0			; dest < 0 <= src   => dest < src  (N=1, Z=0)
	rts

_cmp_unordered:
	; A NaN operand => the comparison is UNORDERED (IEEE 754 5.11): every ordered
	; relation (<, <=, =, >, >=) is false.  A single CCR verdict cannot encode
	; that for the total-order branch instructions, so signal it out of band:
	; V (overflow) = 1, N = 0, Z = 0, and D0 = 2 (distinct from ordered -1/0/+1).
	; A NaN-aware caller / code generator tests it first (BVS, or D0 == 2);
	; a caller reading only N/Z sees "neither less nor equal".  Ordered paths
	; always leave V = 0, so BVS is a reliable unordered test.
	movem.l	(sp)+,d2-d3		; (movem does not affect CCR)
	moveq	#2,d0			; 2 = unordered sentinel
	move.w	#2,ccr			; X=0 N=0 Z=0 V=1 C=0
	rts

	end
