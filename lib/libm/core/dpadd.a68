	title	"IEEE 754 double-precision addition/subtraction"
; ============================================================
;  _fpaddd — double add:  double(8(a6):12(a6)) + double(16(a6):20(a6))
;  _fpsubd — double sub:  negate second arg, then add
;
;  Returns D0:D1 (D0=high, D1=low)
;
;  Mantissa is 53 bits: 21 bits in high word + 32 bits in low word.
;  We work with the full 53-bit mantissa using register pairs.
; ============================================================

	.model	flat
	include	ieee754d.inc

	public	_fpaddd, _fpsubd
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

; ============================================================
;  _fpsubd — negate b then add
; ============================================================
_fpsubd:
	link	a6,#0
	move.l	DBL_ARG2_HI(a6),d0
	eori.l	#IEEE754_DBL_SIGN_MASK_HI,d0
	move.l	d0,DBL_ARG2_HI(a6)
	bra.s	_dpadd_entry

; ============================================================
;  _fpaddd
; ============================================================
_fpaddd:
	link	a6,#0

_dpadd_entry:
	movem.l	d2-d7/a0-a2,-(sp)

	; Load operands: a = d2:d3, b = d4:d5
	move.l	DBL_ARG1_HI(a6),d2	; a high
	move.l	DBL_ARG1_LO(a6),d3	; a low
	move.l	DBL_ARG2_HI(a6),d4	; b high
	move.l	DBL_ARG2_LO(a6),d5	; b low

	; --- Handle zeros ---
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d3,d0
	beq	_dpadd_return_b		; a is zero → return b
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d5,d0
	beq	_dpadd_return_a		; b is zero → return a

	; --- Extract exponents ---
	move.l	d2,d6
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d6
	EXTRACT_DBL_EXP d6		; d6 = a exponent

	move.l	d4,d7
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d7
	EXTRACT_DBL_EXP d7		; d7 = b exponent

	; --- Handle inf/NaN ---
	cmpi.l	#2047,d6
	beq	_dpadd_a_special
	cmpi.l	#2047,d7
	beq	_dpadd_b_special

	; --- Extract signs ---
	move.l	d2,a0			; a0 = a sign (in bit 31)
	move.l	d4,a1			; a1 = b sign

	; --- Extract mantissas; subnormal inputs (exp 0) have no implied bit and
	;     an effective biased exponent of 1 (D3 gradual underflow) ---
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	tst.l	d6
	bne.s	_dpadd_a_norm
	moveq	#1,d6			; subnormal a: eff exp 1, no implied bit
	bra.s	_dpadd_a_mdone
_dpadd_a_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d2 ; d2:d3 = a mantissa (53 bits)
_dpadd_a_mdone:

	andi.l	#IEEE754_DBL_MANT_MASK_HI,d4
	tst.l	d7
	bne.s	_dpadd_b_norm
	moveq	#1,d7
	bra.s	_dpadd_b_mdone
_dpadd_b_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d4 ; d4:d5 = b mantissa (53 bits)
_dpadd_b_mdone:

	; --- Ensure a has larger exponent (swap if needed) ---
	cmp.l	d7,d6
	bge.s	_dpadd_no_swap
	exg	d2,d4
	exg	d3,d5
	exg	d6,d7
	exg	a0,a1
_dpadd_no_swap:

	; d6 = larger exp, d2:d3 = its mantissa, a0 = its sign
	; d7 = smaller exp, d4:d5 = its mantissa, a1 = its sign

	move.l	d6,a2			; a2 = result exponent (saved)
	sub.l	d7,d6			; d6 = exponent difference

	cmpi.l	#55,d6			; shift >= 55 -> smaller below guard+sticky
	blt.s	_dpadd_shift_go
	tst.l	_fe_round
	beq	_dpadd_result_a		; RN -> result is just the larger operand
	moveq	#0,d4			; D4: aligned smaller mantissa = 0
	moveq	#0,d5
	moveq	#1,d7			; guard = 0 (bit31 clear), sticky = 1
	bra	_dpadd_shifted
_dpadd_shift_go:

	; --- Shift smaller mantissa right by d6, capturing guard+sticky in d7 ---
	; [d4:d5:d7] >> d6.  d7 bit31 = guard, lower bits = round/sticky; a 1
	; shifted off d7's bottom is OR'd back so the sticky bit stays set.
	move.l	d6,d1			; d1 = shift count
	moveq	#0,d7			; d7 = guard/sticky accumulator
_dpadd_shift:
	tst.l	d1
	beq.s	_dpadd_shifted
	lsr.l	#1,d4
	roxr.l	#1,d5
	roxr.l	#1,d7
	bcc.s	_dpadd_shift_ns
	ori.l	#1,d7
_dpadd_shift_ns:
	subq.l	#1,d1
	bra.s	_dpadd_shift
_dpadd_shifted:

	; --- Add or subtract based on signs (d7 holds the guard; use d1) ---
	move.l	a0,d6
	move.l	a1,d1
	eor.l	d1,d6			; same sign if bit 31 clear
	btst.l	#31,d6
	bne.s	_dpadd_subtract

	; Same sign: add mantissas (guard d7 = b's fraction; a's fraction = 0)
	add.l	d5,d3			; add low words
	addx.l	d4,d2			; add high words with carry

	; Check for carry out of bit 52 (bit 20 of high word → bit 21)
	btst.l	#21,d2
	beq.s	_dpadd_normalize
	; Shift right 1, increment exponent
	lsr.l	#1,d2
	roxr.l	#1,d3
	roxr.l	#1,d7			; shift guard, preserve sticky
	bcc.s	_dpadd_co_ns
	ori.l	#1,d7
_dpadd_co_ns:
	move.l	a2,d6
	addq.l	#1,d6
	move.l	d6,a2
	cmpi.l	#2047,d6
	bge	_dpadd_overflow
	bra	_dpadd_pack

_dpadd_subtract:
	; Different signs: 96-bit subtract [d2:d3:0] - [d4:d5:d7]
	neg.l	d7			; 0 - b_guard; borrow (X) if guard != 0
	subx.l	d5,d3			; subtract low with guard borrow
	subx.l	d4,d2			; subtract high with borrow
	bpl.s	_dpadd_normalize
	; Result negative: negate 96-bit [d2:d3:d7] and flip sign
	neg.l	d7
	negx.l	d3
	negx.l	d2
	move.l	a0,d6
	eori.l	#IEEE754_DBL_SIGN_MASK_HI,d6
	move.l	d6,a0

_dpadd_normalize:
	; Normalize: shift [d2:d3:d7] left until bit 20 of high word is set
	move.l	d2,d6
	or.l	d3,d6
	or.l	d7,d6
	beq	_dpadd_return_zero	; all zero

_dpadd_norm_loop:
	btst.l	#20,d2			; implied bit position
	bne	_dpadd_pack
	move.l	a2,d6
	cmpi.l	#1,d6			; exponent at min -> subnormal (D3)
	ble.s	_dpadd_subnormal
	lsl.l	#1,d7			; shift guard up into the mantissa
	roxl.l	#1,d3
	roxl.l	#1,d2
	subq.l	#1,d6
	move.l	d6,a2
	bra.s	_dpadd_norm_loop

_dpadd_subnormal:
	; D3 gradual underflow: a2 == 1, bit 20 clear -> subnormal (exp field 0).
	; Round to nearest even from the guard d7; a round-up may carry into the
	; implied bit, promoting to the min normal (exp field 1).
	; D1 (tininess before rounding): the pre-rounding value is tiny, so any
	; inexactness (d7 != 0) raises UNDERFLOW as well as INEXACT.
	tst.l	d7
	beq.s	_dpadd_sub_round	; exact subnormal -> no flags
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status
	tst.l	_fe_round
	bne.s	_dpadd_sub_dir		; D4 directed rounding
	tst.l	d7			; reload guard sign (ori touched CCR)
_dpadd_sub_round:
	bpl.s	_dpadd_sub_pack		; guard clear -> round down
	move.l	d7,d6
	andi.l	#$7FFFFFFF,d6		; sticky bits below the guard
	bne.s	_dpadd_sub_up
	btst.l	#0,d3			; halfway -> round to even
	beq.s	_dpadd_sub_pack
_dpadd_sub_up:
	addq.l	#1,d3
	bcc.s	_dpadd_sub_pack
	addq.l	#1,d2			; carry into the high word
_dpadd_sub_pack:
	btst.l	#20,d2			; carried up to the implied bit?
	beq.s	_dpadd_sub_store
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2 ; rounded up to min normal (exp field 1)
	moveq	#1,d6
	INSERT_DBL_EXP d6
	or.l	d6,d2
	bra.s	_dpadd_sub_sign
_dpadd_sub_store:
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2 ; subnormal mantissa (exp field 0)
_dpadd_sub_sign:
	move.l	a0,d6
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d6
	or.l	d6,d2			; combine sign
	move.l	d2,d0
	move.l	d3,d1
	bra	_dpadd_done

_dpadd_sub_dir:
	; D4 directed subnormal round: inexact (d7 != 0), sign in a0, mag in d2:d3.
	move.l	a0,d1			; sign (bit31) -> d1
	moveq	#1,d0			; inexact = 1
	bsr	_fe_dirup		; d0 = round-up; d2:d3, a0 preserved
	tst.l	d0
	beq.s	_dpadd_sub_pack
	bra.s	_dpadd_sub_up

_dpadd_pack:
	; --- Round to nearest even using guard/sticky in d7 ---
	tst.l	d7
	beq.s	_dpadd_rounded		; d7 == 0 -> exact, no INEXACT
	ori.l	#FE_INEXACT,_fe_status	; bits dropped -> inexact
	tst.l	_fe_round
	bne.s	_dpadd_pack_dir		; D4 directed rounding
	tst.l	d7			; (ori touched CCR) reload the guard sign
	bpl.s	_dpadd_rounded		; guard (bit31) clear -> round down
	move.l	d7,d6
	andi.l	#$7FFFFFFF,d6		; sticky bits below the guard
	bne.s	_dpadd_roundup
	btst.l	#0,d3			; exactly halfway -> round to even
	beq.s	_dpadd_rounded
_dpadd_roundup:
	addq.l	#1,d3
	bcc.s	_dpadd_rup_hi
	addq.l	#1,d2
_dpadd_rup_hi:
	btst.l	#21,d2			; mantissa carried out of bit 52?
	beq.s	_dpadd_rounded
	lsr.l	#1,d2
	roxr.l	#1,d3
	move.l	a2,d6
	addq.l	#1,d6
	move.l	d6,a2
	cmpi.l	#2047,d6
	bge	_dpadd_overflow
_dpadd_rounded:
	; Strip implied bit, pack sign + exponent + mantissa
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2 ; strip implied bit from high

	move.l	a2,d6			; get exponent
	INSERT_DBL_EXP d6		; shift into position
	or.l	d6,d2			; combine exponent

	move.l	a0,d6
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d6
	or.l	d6,d2			; combine sign

	move.l	d2,d0			; result high
	move.l	d3,d1			; result low

_dpadd_done:
	movem.l	(sp)+,d2-d7/a0-a2
	unlk	a6
	rts

_dpadd_pack_dir:
	; D4 directed normal round: inexact (d7 != 0), sign in a0, mag in d2:d3.
	move.l	a0,d1			; sign (bit31) -> d1
	moveq	#1,d0			; inexact = 1
	bsr	_fe_dirup		; d0 = round-up; d2:d3, a0 preserved
	tst.l	d0
	beq.s	_dpadd_rounded
	bra.s	_dpadd_roundup

; --- Special cases ---

_dpadd_return_a:
	move.l	d2,d0
	move.l	d3,d1
	bra.s	_dpadd_done

_dpadd_return_b:
	move.l	d4,d0
	move.l	d5,d1
	bra.s	_dpadd_done

_dpadd_result_a:
	; Reconstruct a from mantissa and exponent.  The smaller operand is nonzero
	; (zeros handled early) so the true sum differs from a -> INEXACT (D1).
	ori.l	#FE_INEXACT,_fe_status
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	move.l	a2,d6
	INSERT_DBL_EXP d6
	or.l	d6,d2
	move.l	a0,d6
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d6
	or.l	d6,d2
	move.l	d2,d0
	move.l	d3,d1
	bra	_dpadd_done

_dpadd_return_zero:
	moveq	#0,d0
	moveq	#0,d1
	bra	_dpadd_done

_dpadd_overflow:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status ; D1: overflow implies inexact
	move.l	a0,d1
	andi.l	#$80000000,d1		; sign
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf ; d1 = sign
	tst.l	d0
	bne.s	_dpadd_ovf_max
	move.l	d1,d0
	ori.l	#DBL_INF_HI,d0		; signed inf
	moveq	#0,d1
	bra	_dpadd_done
_dpadd_ovf_max:
	move.l	d1,d0
	ori.l	#$7FEFFFFF,d0		; signed max-finite (hi)
	moveq	#-1,d1			; max-finite lo = 0xFFFFFFFF
	bra	_dpadd_done

_dpadd_a_special:
	; a is inf or NaN
	move.l	DBL_ARG1_HI(a6),d0
	move.l	DBL_ARG1_LO(a6),d1
	move.l	d0,d2
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d1,d2
	bne	_dpadd_ret_nan		; a is NaN -> NaN
	; a is inf; inspect b
	move.l	DBL_ARG2_HI(a6),d2
	move.l	DBL_ARG2_LO(a6),d3
	move.l	d2,d4
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	cmpi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	bne	_dpadd_done		; b finite -> inf + finite = inf (=a)
	move.l	d2,d4
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d4
	or.l	d3,d4
	bne	_dpadd_ret_nan		; b is NaN -> NaN
	; both inf: opposite signs -> inf + (-inf) = NaN
	eor.l	d0,d2
	bmi	_dpadd_invalid
	bra	_dpadd_done		; same sign -> inf

_dpadd_invalid:
	ori.l	#FE_INVALID,_fe_status	; D1: inf + (-inf) (signaled invalid)
_dpadd_ret_nan:
	move.l	#$7FF80000,d0
	moveq	#0,d1
	bra	_dpadd_done

_dpadd_b_special:
	; a is finite (a_special not taken), b is inf or NaN -> return b
	move.l	DBL_ARG2_HI(a6),d0
	move.l	DBL_ARG2_LO(a6),d1
	bra	_dpadd_done

	end
