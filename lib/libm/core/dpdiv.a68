	title	"IEEE 754 double-precision division"
; ============================================================
;  _fpdivd — double divide: a / b
;
;  Uses restoring division on 53-bit mantissas.
;  53 iterations of shift-and-subtract on register pairs.
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpdivd
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

_fpdivd:
	link	a6,#0
	movem.l	d2-d7/a0-a2,-(sp)

	move.l	DBL_ARG1_HI(a6),d2
	move.l	DBL_ARG1_LO(a6),d3
	move.l	DBL_ARG2_HI(a6),d4
	move.l	DBL_ARG2_LO(a6),d5

	; Result sign
	move.l	d2,d0
	eor.l	d4,d0
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d0
	move.l	d0,a0

	; Extract exponents
	move.l	d2,d6
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d6
	EXTRACT_DBL_EXP d6

	move.l	d4,d7
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d7
	EXTRACT_DBL_EXP d7

	; --- Handle inf/NaN FIRST (so 0/0, inf/inf -> NaN) ---
	cmpi.l	#2047,d6
	beq	_dpdiv_a_special
	cmpi.l	#2047,d7
	beq	_dpdiv_b_special

	; --- Zeros ---
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d3,d0
	beq	_dpdiv_a_zero		; 0 / x
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d5,d0
	beq	_dpdiv_inf		; x / 0 = inf (x nonzero finite)

	; --- Extract mantissas; pre-normalize subnormal inputs (D3) ---
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	tst.l	d6
	bne.s	_dpdiv_a_norm
	moveq	#1,d6
_dpdiv_a_nloop:
	subq.l	#1,d6
	lsl.l	#1,d3
	roxl.l	#1,d2
	btst.l	#20,d2
	beq.s	_dpdiv_a_nloop
	bra.s	_dpdiv_a_ndone
_dpdiv_a_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d2
_dpdiv_a_ndone:

	andi.l	#IEEE754_DBL_MANT_MASK_HI,d4
	tst.l	d7
	bne.s	_dpdiv_b_norm
	moveq	#1,d7
_dpdiv_b_nloop:
	subq.l	#1,d7
	lsl.l	#1,d5
	roxl.l	#1,d4
	btst.l	#20,d4
	beq.s	_dpdiv_b_nloop
	bra.s	_dpdiv_b_ndone
_dpdiv_b_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d4
_dpdiv_b_ndone:

	; Result exponent = ea - eb + bias
	sub.l	d7,d6
	addi.l	#IEEE754_DBL_EXP_BIAS,d6
	move.l	d6,a2

	; --- Pre-align so dividend >= divisor (quotient in [1,2)) ---
	cmp.l	d4,d2
	bhi.s	_dpdiv_go
	bcs.s	_dpdiv_prealign
	cmp.l	d5,d3
	bcc.s	_dpdiv_go		; dividend >= divisor
_dpdiv_prealign:
	lsl.l	#1,d3
	roxl.l	#1,d2			; dividend <<= 1
	move.l	a2,d6
	subq.l	#1,d6
	move.l	d6,a2			; result exp -= 1
_dpdiv_go:

	; --- Restoring division: 54 iterations (53 mantissa + 1 guard bit) ---
	moveq	#0,d0
	moveq	#0,d1
	moveq	#54,d7

_dpdiv_loop:
	; Shift quotient left 1
	lsl.l	#1,d1
	roxl.l	#1,d0

	; Compare dividend >= divisor
	cmp.l	d4,d2
	bhi.s	_dpdiv_sub		; high word greater → subtract
	bcs.s	_dpdiv_nosub		; high word less → no subtract
	cmp.l	d5,d3			; high equal, compare low
	bcs.s	_dpdiv_nosub

_dpdiv_sub:
	sub.l	d5,d3
	subx.l	d4,d2
	ori.l	#1,d1			; set quotient bit

_dpdiv_nosub:
	; Shift dividend (remainder) left 1
	lsl.l	#1,d3
	roxl.l	#1,d2

	subq.l	#1,d7
	bne.s	_dpdiv_loop

	; d0:d1 = 54-bit quotient: implied bit at bit 53 (bit 21 of d0),
	; guard = bit 0; remainder d2:d3 != 0 => sticky.  (d4:d5 divisor dead.)
	move.l	d1,d4
	andi.l	#1,d4			; d4 = guard bit
	move.l	d2,d5
	or.l	d3,d5			; d5 != 0 => sticky
	lsr.l	#1,d0			; drop guard -> implied at bit 20 of d0
	roxr.l	#1,d1

	; --- Exponent bounds: subnormal -> gradual underflow (D3); overflow -> inf ---
	move.l	a2,d6
	cmpi.l	#2047,d6
	bge	_dpdiv_overflow
	tst.l	d6
	ble	_dpdiv_subnormal

	; --- Round to nearest even ---
	move.l	d4,d6
	or.l	d5,d6			; guard | sticky
	beq.s	_dpdiv_pack		; both 0 -> exact, no INEXACT
	ori.l	#FE_INEXACT,_fe_status	; remainder nonzero -> inexact
	tst.l	_fe_round
	bne	_dpdiv_round_dir	; D4 directed rounding
	tst.l	d4			; guard set?
	beq.s	_dpdiv_pack		; guard clear (inexact via sticky) -> round down
	tst.l	d5			; sticky?
	bne.s	_dpdiv_roundup
	btst.l	#0,d1			; exactly halfway -> round to even
	beq.s	_dpdiv_pack
_dpdiv_roundup:
	addq.l	#1,d1
	bcc.s	_dpdiv_rup_hi
	addq.l	#1,d0
_dpdiv_rup_hi:
	btst.l	#21,d0			; carried out of bit 52?
	beq.s	_dpdiv_pack
	lsr.l	#1,d0
	roxr.l	#1,d1
	move.l	a2,d6
	addq.l	#1,d6
	move.l	d6,a2
	cmpi.l	#2047,d6
	bge	_dpdiv_overflow
_dpdiv_pack:
	move.l	a2,d6
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	INSERT_DBL_EXP d6
	or.l	d6,d0
	move.l	a0,d6
	or.l	d6,d0
	bra.s	_dpdiv_done

_dpdiv_subnormal:
	; D3 gradual underflow: d0:d1 = 53-bit quotient (implied@20), d4 = guard bit,
	; d5 = division remainder sticky, a2 <= 0.  Fold guard+remainder into a tail
	; sticky, shift right by k = 1 - a2, round-to-nearest-even, exp field 0.
	or.l	d4,d5			; d5 != 0 -> bits exist below the quotient LSB
	move.l	a2,d7
	moveq	#1,d6
	sub.l	d7,d6			; d6 = k (>= 1)
	cmpi.l	#55,d6			; below 1/2 ULP of the min subnormal -> +/-0
	bge	_dpdiv_underflow
	move.l	d6,d7			; d7 = shift counter
	moveq	#0,d6			; d6 = guard/sticky accumulator
_dpdiv_sub_shift:
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d6
	bcc.s	_dpdiv_sub_shs
	ori.l	#1,d6
_dpdiv_sub_shs:
	subq.l	#1,d7
	bne.s	_dpdiv_sub_shift
	tst.l	d5			; fold the below-quotient tail sticky in
	beq.s	_dpdiv_sub_round
	ori.l	#1,d6
_dpdiv_sub_round:
	tst.l	d6			; any guard/sticky bits -> tiny + inexact
	beq.s	_dpdiv_sub_rnd2		; exact subnormal -> no flags
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status
	tst.l	_fe_round
	bne	_dpdiv_sub_dir		; D4 directed rounding
	tst.l	d6
_dpdiv_sub_rnd2:
	bpl.s	_dpdiv_sub_pack		; guard (bit31) clear -> round down
	move.l	d6,d7
	andi.l	#$7FFFFFFF,d7
	bne.s	_dpdiv_sub_up
	btst.l	#0,d1			; halfway -> round to even
	beq.s	_dpdiv_sub_pack
_dpdiv_sub_up:
	addq.l	#1,d1
	bcc.s	_dpdiv_sub_pack
	addq.l	#1,d0
_dpdiv_sub_pack:
	btst.l	#20,d0			; carried up to the min normal?
	beq.s	_dpdiv_sub_store
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	moveq	#1,d6
	INSERT_DBL_EXP d6
	or.l	d6,d0
	bra.s	_dpdiv_sub_sign
_dpdiv_sub_store:
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0 ; subnormal mantissa (exp field 0)
_dpdiv_sub_sign:
	move.l	a0,d6
	or.l	d6,d0

_dpdiv_done:
	movem.l	(sp)+,d2-d7/a0-a2
	unlk	a6
	rts

_dpdiv_round_dir:
	; D4 directed normal round: inexact (d4|d5 != 0), sign a0, quotient d0:d1.
	movem.l	d0-d1,-(sp)		; save quotient (movem preserves CCR on restore)
	move.l	a0,d1			; sign -> d1
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = round-up
	tst.l	d0
	movem.l	(sp)+,d0-d1		; restore quotient (CCR unchanged)
	beq	_dpdiv_pack
	bra	_dpdiv_roundup

_dpdiv_sub_dir:
	; D4 directed subnormal round: inexact (d6 != 0), sign a0, quotient d0:d1.
	movem.l	d0-d1,-(sp)
	move.l	a0,d1
	moveq	#1,d0
	bsr	_fe_dirup
	tst.l	d0
	movem.l	(sp)+,d0-d1
	beq	_dpdiv_sub_pack
	bra	_dpdiv_sub_up

_dpdiv_zero:
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d6
	or.l	d6,d0			; signed zero
	bra.s	_dpdiv_done

_dpdiv_inf:
	ori.l	#FE_DIVBYZERO,_fe_status ; D1: finite / 0
	move.l	#DBL_INF_HI,d0
	moveq	#0,d1
	move.l	a0,d6
	or.l	d6,d0
	bra.s	_dpdiv_done

_dpdiv_underflow:
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status ; D1: tiny nonzero quotient -> 0
	move.l	a0,d1			; sign
	moveq	#1,d0			; inexact (tiny nonzero)
	bsr	_fe_dirup		; RU-of-pos / RD-of-neg -> up to min subnormal
	tst.l	d0
	beq.s	_dpdiv_unf_zero
	move.l	a0,d0
	andi.l	#$80000000,d0		; sign | 0 (hi)
	moveq	#1,d1			; min-subnormal lo = 1
	bra	_dpdiv_done
_dpdiv_unf_zero:
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d6
	or.l	d6,d0			; signed zero
	bra	_dpdiv_done

_dpdiv_overflow:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status ; D1: overflow implies inexact
	move.l	a0,d1
	andi.l	#$80000000,d1		; sign
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf ; d1 = sign
	tst.l	d0
	bne.s	_dpdiv_ovf_max
	move.l	d1,d0
	ori.l	#DBL_INF_HI,d0
	moveq	#0,d1
	bra	_dpdiv_done
_dpdiv_ovf_max:
	move.l	d1,d0
	ori.l	#$7FEFFFFF,d0		; signed max-finite (hi)
	moveq	#-1,d1			; max-finite lo = 0xFFFFFFFF
	bra	_dpdiv_done

_dpdiv_a_special:
	; a is inf or NaN
	move.l	DBL_ARG1_HI(a6),d0
	move.l	DBL_ARG1_LO(a6),d1
	move.l	d0,d2
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d1,d2
	bne	_dpdiv_ret_nan		; a is NaN
	; a is inf: b inf -> inf/inf (INVALID); b NaN -> propagate; b finite -> inf
	move.l	DBL_ARG2_HI(a6),d2
	move.l	DBL_ARG2_LO(a6),d3
	move.l	d2,d4
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	cmpi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	bne.s	_dpdiv_a_inf		; b finite -> inf / finite = inf
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d3,d2
	bne	_dpdiv_ret_nan		; b is NaN -> propagate (no invalid)
	bra	_dpdiv_invalid		; b is inf -> inf / inf (invalid)
_dpdiv_a_inf:
	move.l	#DBL_INF_HI,d0
	moveq	#0,d1
	move.l	a0,d2
	or.l	d2,d0			; signed inf
	bra	_dpdiv_done

_dpdiv_b_special:
	; a finite, b is inf or NaN
	move.l	DBL_ARG2_HI(a6),d0
	move.l	DBL_ARG2_LO(a6),d1
	move.l	d0,d2
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d1,d2
	bne	_dpdiv_ret_nan		; b is NaN
	; b is inf: finite / inf = signed 0
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d2
	or.l	d2,d0
	bra	_dpdiv_done

_dpdiv_a_zero:
	; a is zero: 0/0 -> NaN; 0/finite -> signed 0
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d5,d0
	beq	_dpdiv_invalid		; 0 / 0 = NaN (invalid)
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d2
	or.l	d2,d0			; signed zero
	bra	_dpdiv_done

_dpdiv_invalid:
	ori.l	#FE_INVALID,_fe_status	; D1: 0/0 or inf/inf (signaled invalid)
_dpdiv_ret_nan:
	move.l	#DBL_QNAN_HI,d0
	move.l	#DBL_QNAN_LO,d1
	bra	_dpdiv_done

	end
