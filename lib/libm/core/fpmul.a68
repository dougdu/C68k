	title	"IEEE 754 single-precision multiplication"
; ============================================================
;  _fpmult / _fpmultf — single-precision multiplication
;
;  float _fpmult(float a, float b) — returns a * b in D0
;  Arguments: 8(A6)=a, 12(A6)=b  (after LINK)
;
;  Algorithm:
;    1. XOR signs
;    2. Add exponents (subtract bias)
;    3. Multiply 24-bit mantissas → 48-bit product
;       using partial products: (aH*bH)<<32 + (aH*bL + aL*bH)<<16 + aL*bL
;       Only need upper 25 bits for rounding
;    4. Normalize, round, pack
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpmult, _fpmultf
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

_fpmult:
_fpmultf:
	link	a6,#0
	movem.l	d2-d7/a0,-(sp)

	move.l	8(a6),d6		; d6 = a
	move.l	12(a6),d7		; d7 = b

	; --- Result sign = XOR of input signs ---
	move.l	d6,d0
	eor.l	d7,d0
	andi.l	#IEEE754_SNG_SIGN_MASK,d0
	move.l	d0,a0			; a0 = result sign (saved)

	; --- Extract exponents ---
	move.l	d6,d2
	andi.l	#IEEE754_SNG_EXP_MASK,d2
	EXTRACT_EXP d2

	move.l	d7,d3
	andi.l	#IEEE754_SNG_EXP_MASK,d3
	EXTRACT_EXP d3

	; --- Handle inf/NaN FIRST so 0*inf and 0*NaN -> NaN (not 0) ---
	cmpi.l	#255,d2
	beq	_mul_a_special
	cmpi.l	#255,d3
	beq	_mul_b_special

	; --- Handle zeros (neither operand is inf/NaN at this point) ---
	move.l	d6,d0
	andi.l	#$7FFFFFFF,d0
	beq	_mul_return_zero
	move.l	d7,d0
	andi.l	#$7FFFFFFF,d0
	beq	_mul_return_zero

	; --- Extract mantissas; pre-normalize subnormal inputs (D3) ---
	; A subnormal operand (exp field 0) has no implied bit; normalize its
	; mantissa to bit 23 and drop its effective exponent below 1 accordingly.
	move.l	d6,d4
	andi.l	#IEEE754_SNG_MANT_MASK,d4
	tst.l	d2
	bne.s	_mul_a_haveimp
	moveq	#1,d2
_mul_a_nloop:
	subq.l	#1,d2
	lsl.l	#1,d4
	btst.l	#IEEE754_SNG_MANT_BITS,d4
	beq.s	_mul_a_nloop
	bra.s	_mul_a_done
_mul_a_haveimp:
	ori.l	#IEEE754_SNG_IMPLIED_BIT,d4 ; d4 = a mantissa (24 bits)
_mul_a_done:

	move.l	d7,d5
	andi.l	#IEEE754_SNG_MANT_MASK,d5
	tst.l	d3
	bne.s	_mul_b_haveimp
	moveq	#1,d3
_mul_b_nloop:
	subq.l	#1,d3
	lsl.l	#1,d5
	btst.l	#IEEE754_SNG_MANT_BITS,d5
	beq.s	_mul_b_nloop
	bra.s	_mul_b_done
_mul_b_haveimp:
	ori.l	#IEEE754_SNG_IMPLIED_BIT,d5 ; d5 = b mantissa (24 bits)
_mul_b_done:

	; --- Result exponent = ea + eb - bias ---
	add.l	d3,d2			; d2 = ea + eb
	subi.l	#IEEE754_SNG_EXP_BIAS,d2 ; subtract bias

	; --- 24x24 → 48-bit multiply using 16x16 partial products ---
	; d4 = aH:aL (upper 8 : lower 16), d5 = bH:bL
	; Product = aH*bH*2^32 + (aH*bL + aL*bH)*2^16 + aL*bL
	; We only need the upper 25 bits of the 48-bit product.

	move.l	d4,d0
	swap	d0			; d0.w = aH (upper 8 bits of mantissa in bits 7-0)
	andi.l	#$FFFF,d0		; d0 = aH
	move.l	d4,d1
	andi.l	#$FFFF,d1		; d1 = aL

	move.l	d5,d3
	swap	d3
	andi.l	#$FFFF,d3		; d3 = bH
	move.l	d5,d6
	andi.l	#$FFFF,d6		; d6 = bL

	; Partial products
	move.l	d1,d7
	mulu	d6,d7			; d7 = aL * bL (low partial, 32 bits)

	move.l	d0,d4
	mulu	d6,d4			; d4 = aH * bL

	move.l	d1,d5
	mulu	d3,d5			; d5 = aL * bH

	mulu	d3,d0			; d0 = aH * bH

	; Capture the low 16 product bits (aL*bL[15:0]) that the combine
	; below discards; they are the round "sticky".  bH (d3) is dead now.
	move.l	d7,d3
	andi.l	#$FFFF,d3		; d3 = product bits 15:0 (low sticky)

	; Combine: build bits 47:16 of the 48-bit product in d0
	; middle_sum = (aL*bL >> 16) + aH*bL + aL*bH
	swap	d7			; d7 high word = (aL*bL) >> 16
	andi.l	#$FFFF,d7
	add.l	d4,d7			; + aH*bL
	add.l	d5,d7			; + aL*bH
	; d7 = middle_sum (up to ~26 bits)
	; d0 = aH*bH (up to 16 bits) = bits 47:32 of product
	; Extract carry from middle_sum into high part
	move.l	d7,d1			; save middle_sum
	swap	d7
	andi.l	#$FFFF,d7		; d7 = middle_sum >> 16 (carry into high)
	add.l	d7,d0			; d0 = complete bits 47:32
	; Now combine into 32-bit value: d0 = bits 47:16
	swap	d0			; move bits 47:32 to upper word
	clr.w	d0			; clear low word
	andi.l	#$FFFF,d1		; d1 = middle_sum low 16 = bits 31:16
	or.l	d1,d0			; d0 = bits 47:16 of product

	; The implied bit product (1*1) is at bit 46 of the 48-bit product,
	; which is bit 30 of our 32-bit d0.  If the product >= 2.0 (both
	; mantissas large enough), bit 47 → bit 31 is set instead.

	; Fold the discarded low bits (d3) into a single sticky at bit 0.
	; Bit 0 of d0 is product bit 16, already inside the round/sticky
	; field, so OR-ing there preserves the guard and mantissa bits.
	tst.l	d3
	beq.s	_mul_sticky_done
	ori.l	#1,d0
_mul_sticky_done:
	; d0 = product bits 47:16 (implied-bit product at bit 30, or 31 if >=2.0),
	; low bits folded to a sticky at bit 0.  d2 = ea + eb - bias.
	btst.l	#31,d0			; product >= 2.0?
	beq.s	_mul_shift7
	addq.l	#1,d2			; product in [2,4): exponent + 1
	moveq	#8,d1			; base shift = 8 (guard @ bit 7)
	bra.s	_mul_haveexp
_mul_shift7:
	moveq	#7,d1			; product in [1,2): base shift = 7 (guard @ bit 6)
_mul_haveexp:
	cmpi.l	#255,d2			; overflow?
	bge	_mul_overflow
	tst.l	d2			; subnormal result? (biased exp <= 0)
	bgt.s	_mul_do_round
	; --- D3 gradual underflow: total shift = base + (1 - d2), exp field 0 ---
	moveq	#1,d3
	sub.l	d2,d3			; 1 - d2  (>= 1)
	add.l	d3,d1			; d1 = total right shift
	moveq	#0,d2			; exp field 0 (subnormal)
	cmpi.l	#33,d1			; below 1/2 ULP of the min subnormal -> +/-0
	bge	_mul_underflow
_mul_do_round:
	; round-to-nearest-even: d0 >> d1  (1 <= d1 <= 32), sticky already folded
	move.l	d0,d6			; d6 = pre-shift value
	lsr.l	d1,d0			; d0 = truncated mantissa
	moveq	#1,d3
	lsl.l	d1,d3
	subq.l	#1,d3			; d3 = (1<<d1) - 1  (low-bit mask)
	and.l	d6,d3			; d3 = discarded bits
	beq.s	_mul_r_exact		; d3 == 0 -> exact, no flags
	ori.l	#FE_INEXACT,_fe_status	; D1: bits dropped -> inexact
	tst.l	d2			; subnormal (exp field 0)? tininess-before -> UNDERFLOW
	bne.s	_mul_r_exact
	ori.l	#FE_UNDERFLOW,_fe_status
_mul_r_exact:
	moveq	#1,d7
	move.l	d1,d5
	subq.l	#1,d5
	lsl.l	d5,d7			; d7 = half = 1 << (d1-1)
	tst.l	_fe_round
	bne	_mul_round_dir		; D4 directed rounding
	cmp.l	d7,d3
	blo.s	_mul_pack		; below half -> truncate
	bhi.s	_mul_rup		; above half -> round up
	btst.l	#0,d0			; exactly half -> round to even
	beq.s	_mul_pack
_mul_rup:
	addq.l	#1,d0
_mul_pack:
	tst.l	d2			; subnormal (exp field 0)?
	bne.s	_mul_pack_normal
	; subnormal pack: a round-up may have carried into the implied bit,
	; promoting the result to the min normal (exp field 1).
	btst.l	#IEEE754_SNG_MANT_BITS,d0
	beq.s	_mul_pack_sub
	andi.l	#IEEE754_SNG_MANT_MASK,d0
	moveq	#1,d2
	INSERT_EXP d2
	or.l	d2,d0
	bra.s	_mul_apply_sign
_mul_pack_sub:
	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; subnormal mantissa (exp field 0)
	bra.s	_mul_apply_sign
_mul_pack_normal:
	cmpi.l	#$1000000,d0		; mantissa overflowed to 0x1000000?
	blo.s	_mul_pack_n2
	lsr.l	#1,d0			; renormalize
	addq.l	#1,d2			; bump exponent
	cmpi.l	#255,d2
	bge	_mul_overflow
_mul_pack_n2:
	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; strip implied bit
	INSERT_EXP d2
	or.l	d2,d0			; combine
_mul_apply_sign:
	move.l	a0,d1			; get sign
	or.l	d1,d0			; apply sign

_mul_done:
	movem.l	(sp)+,d2-d7/a0
	unlk	a6
	rts

_mul_round_dir:
	; D4 directed: d3 = discarded bits (inexact), d0 = truncated mantissa,
	; a0 = sign.  Round the magnitude up per the current mode.
	tst.l	d3
	beq	_mul_pack		; exact -> truncate
	move.l	d0,d6			; save mantissa
	move.l	a0,d1			; sign
	moveq	#1,d0			; inexact = 1
	bsr	_fe_dirup		; d0 = round-up (0/1)
	tst.l	d0
	beq.s	_mul_rd_dn
	move.l	d6,d0
	bra	_mul_rup
_mul_rd_dn:
	move.l	d6,d0
	bra	_mul_pack

; --- Special cases ---

_mul_return_zero:
	move.l	a0,d0			; signed zero
	bra.s	_mul_done

_mul_underflow:
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status ; D1: tiny nonzero product -> 0
	move.l	a0,d1			; sign
	moveq	#1,d0			; inexact (tiny nonzero)
	bsr	_fe_dirup		; RU-of-pos / RD-of-neg -> up to min subnormal
	tst.l	d0
	beq.s	_mul_unf_zero
	move.l	a0,d0
	andi.l	#$80000000,d0
	ori.l	#1,d0			; sign | min-subnormal
	bra	_mul_done
_mul_unf_zero:
	move.l	a0,d0			; signed zero
	bra	_mul_done

_mul_overflow:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status ; D1: overflow implies inexact
	move.l	a0,d1
	andi.l	#$80000000,d1		; sign
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf ; d1 = sign
	tst.l	d0
	bne.s	_mul_ovf_max
	move.l	d1,d0
	ori.l	#SNG_INF,d0		; signed infinity
	bra	_mul_done
_mul_ovf_max:
	move.l	d1,d0
	ori.l	#$7F7FFFFF,d0		; signed max-finite (directed)
	bra	_mul_done

_mul_a_special:
	; a is inf or NaN
	move.l	d6,d0
	andi.l	#IEEE754_SNG_MANT_MASK,d0
	bne.s	_mul_nan		; a is NaN
	; a is inf: inf * 0 = NaN, inf * NaN = NaN, inf * finite/inf = inf
	move.l	d7,d0
	andi.l	#$7FFFFFFF,d0		; d0 = |b|
	beq.s	_mul_invalid		; inf * 0 = NaN (INVALID)
	cmpi.l	#SNG_INF,d0		; |b| > inf  =>  b is NaN
	bhi.s	_mul_nan		; inf * NaN = NaN
	move.l	#SNG_INF,d0
	move.l	a0,d1
	or.l	d1,d0
	bra.s	_mul_done

_mul_b_special:
	; b is inf or NaN
	move.l	d7,d0
	andi.l	#IEEE754_SNG_MANT_MASK,d0
	bne.s	_mul_nan		; b is NaN
	; b is inf: 0 * inf = NaN
	move.l	d6,d0
	andi.l	#$7FFFFFFF,d0
	beq.s	_mul_invalid
	move.l	#SNG_INF,d0
	move.l	a0,d1
	or.l	d1,d0
	bra.s	_mul_done

_mul_invalid:
	ori.l	#FE_INVALID,_fe_status	; D1: 0*inf (signaled invalid)
_mul_nan:
	move.l	#SNG_QNAN,d0
	bra	_mul_done

	end
