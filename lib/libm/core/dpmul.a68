	title	"IEEE 754 double-precision multiplication"
; ============================================================
;  _fpmultd — double multiply
;
;  Returns D0:D1.  Args at 8(a6) and 16(a6), each 8 bytes.
;
;  Full 53-bit precision using shift-and-add:
;    96-bit accumulator, 53 iterations scanning the multiplier
;    from MSB to LSB.  Each iteration right-shifts the accumulator,
;    then conditionally adds the full 53-bit multiplicand.
;    Result mantissa lands at bit 20 of D0 (correct double position).
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpmultd
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

_fpmultd:
	link	a6,#0
	movem.l	d2-d7/a0-a2,-(sp)

	move.l	DBL_ARG1_HI(a6),d2	; a high
	move.l	DBL_ARG1_LO(a6),d3	; a low
	move.l	DBL_ARG2_HI(a6),d4	; b high
	move.l	DBL_ARG2_LO(a6),d5	; b low

	; --- Result sign ---
	move.l	d2,d0
	eor.l	d4,d0
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d0
	move.l	d0,a0			; a0 = result sign

	; --- Extract exponents ---
	move.l	d2,d6
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d6
	EXTRACT_DBL_EXP d6

	move.l	d4,d7
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d7
	EXTRACT_DBL_EXP d7

	; --- Handle inf/NaN FIRST so 0*inf and inf*0 -> NaN ---
	cmpi.l	#2047,d6
	beq	_dpmul_a_special
	cmpi.l	#2047,d7
	beq	_dpmul_b_special

	; --- Handle zeros (neither operand is inf/NaN) ---
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d3,d0
	beq	_dpmul_zero
	move.l	d4,d0
	andi.l	#$7FFFFFFF,d0
	or.l	d5,d0
	beq	_dpmul_zero

	; --- Extract mantissas; pre-normalize subnormal inputs (D3) ---
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	tst.l	d6
	bne.s	_dpmul_a_norm
	moveq	#1,d6			; subnormal a: normalize d2:d3 to bit 20, adjust exp
_dpmul_a_nloop:
	subq.l	#1,d6
	lsl.l	#1,d3
	roxl.l	#1,d2
	btst.l	#20,d2
	beq.s	_dpmul_a_nloop
	bra.s	_dpmul_a_ndone
_dpmul_a_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d2 ; d2:d3 = multiplicand (53 bits)
_dpmul_a_ndone:

	andi.l	#IEEE754_DBL_MANT_MASK_HI,d4
	tst.l	d7
	bne.s	_dpmul_b_norm
	moveq	#1,d7
_dpmul_b_nloop:
	subq.l	#1,d7
	lsl.l	#1,d5
	roxl.l	#1,d4
	btst.l	#20,d4
	beq.s	_dpmul_b_nloop
	bra.s	_dpmul_b_ndone
_dpmul_b_norm:
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d4 ; d4:d5 = multiplier (53 bits)
_dpmul_b_ndone:

	; Result exponent = ea + eb - bias
	add.l	d7,d6
	subi.l	#IEEE754_DBL_EXP_BIAS,d6
	move.l	d6,a2			; a2 = result exponent

	; --- Shift-and-add multiplication: LSB-first, right-shift accumulator ---
	; Multiplier d4:d5 (53 bits): d4 has upper 21 bits (20..0), d5 has lower 32
	; Process d5 first (bits 0..31), then d4 (bits 32..52 = d4 bits 0..20)

	; --- Initialize 96-bit accumulator: d0:d1:d6 = 0 ---
	moveq	#0,d0
	moveq	#0,d1
	moveq	#0,d6

	; --- First loop: process 32 bits from d5 (LSB first) ---
	moveq	#32,d7
_dpmul_loop1:
	; Shift accumulator right 1 FIRST (96 bits)
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d6
	bcc.s	_dpmul_l1s
	ori.l	#1,d6			; sticky: keep a 1 shifted off the bottom
_dpmul_l1s:
	; Shift multiplier right, LSB into carry
	lsr.l	#1,d5
	bcc.s	_dpmul_noadd1
	; Add multiplicand (d2:d3) to upper 64 bits of accumulator
	add.l	d3,d1
	addx.l	d2,d0
_dpmul_noadd1:
	subq.l	#1,d7
	bne.s	_dpmul_loop1

	; --- Second loop: process 21 bits from d4 (bits 0..20, LSB first) ---
	moveq	#21,d7
_dpmul_loop2:
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d6
	bcc.s	_dpmul_l2s
	ori.l	#1,d6
_dpmul_l2s:
	lsr.l	#1,d4
	bcc.s	_dpmul_noadd2
	add.l	d3,d1
	addx.l	d2,d0
_dpmul_noadd2:
	subq.l	#1,d7
	bne.s	_dpmul_loop2

	; --- d0:d1 = result mantissa, implied bit at bit 20 (or 21 if >= 2) ---

	btst.l	#21,d0			; product >= 2?
	beq.s	_dpmul_no_extra
	; Shift right 1, increment exponent
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d6			; shift guard, preserve sticky
	bcc.s	_dpmul_ne_s
	ori.l	#1,d6
_dpmul_ne_s:
	move.l	a2,d7
	addq.l	#1,d7
	move.l	d7,a2
_dpmul_no_extra:
	; --- Exponent bounds: subnormal -> gradual underflow (D3); overflow -> inf ---
	move.l	a2,d7
	cmpi.l	#2047,d7
	bge	_dpmul_overflow
	tst.l	d7
	ble	_dpmul_subnormal
	; --- Round to nearest even using guard/sticky in d6 ---
	tst.l	d6
	beq.s	_dpmul_pack		; d6 == 0 -> exact, no INEXACT
	ori.l	#FE_INEXACT,_fe_status	; bits dropped -> inexact
	tst.l	_fe_round
	bne	_dpmul_round_dir	; D4 directed rounding
	tst.l	d6			; (ori touched CCR) reload guard sign
	bpl.s	_dpmul_pack		; guard clear -> round down
	move.l	d6,d7
	andi.l	#$7FFFFFFF,d7		; sticky bits below the guard
	bne.s	_dpmul_roundup
	btst.l	#0,d1			; exactly halfway -> round to even
	beq.s	_dpmul_pack
_dpmul_roundup:
	addq.l	#1,d1
	bcc.s	_dpmul_rup_hi
	addq.l	#1,d0
_dpmul_rup_hi:
	btst.l	#21,d0			; mantissa carried out of bit 52?
	beq.s	_dpmul_pack
	lsr.l	#1,d0
	roxr.l	#1,d1
	move.l	a2,d7
	addq.l	#1,d7
	move.l	d7,a2
	cmpi.l	#2047,d7
	bge	_dpmul_overflow
_dpmul_pack:
	; --- Pack result ---
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	move.l	a2,d6
	INSERT_DBL_EXP d6
	or.l	d6,d0
	move.l	a0,d6
	or.l	d6,d0
	bra.s	_dpmul_done

_dpmul_subnormal:
	; D3 gradual underflow: d0:d1 mantissa (implied@20), d6 = guard/sticky,
	; a2 <= 0.  Shift right by k = 1 - a2 into the subnormal grid; round-to-
	; nearest-even; a round-up may promote to the min normal (exp field 1).
	move.l	a2,d7
	moveq	#1,d2
	sub.l	d7,d2			; d2 = k (>= 1)
	cmpi.l	#54,d2			; below 1/2 ULP of the min subnormal -> +/-0
	bge	_dpmul_underflow
_dpmul_sub_shift:
	lsr.l	#1,d0
	roxr.l	#1,d1
	roxr.l	#1,d6
	bcc.s	_dpmul_sub_shs
	ori.l	#1,d6			; keep a shifted-off 1 as sticky
_dpmul_sub_shs:
	subq.l	#1,d2
	bne.s	_dpmul_sub_shift
	tst.l	d6
	beq.s	_dpmul_sub_round	; exact subnormal -> no flags
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status ; tininess-before: tiny + inexact
	tst.l	_fe_round
	bne	_dpmul_sub_dir		; D4 directed rounding
	tst.l	d6			; reload guard sign (ori touched CCR)
_dpmul_sub_round:
	bpl.s	_dpmul_sub_pack
	move.l	d6,d7
	andi.l	#$7FFFFFFF,d7
	bne.s	_dpmul_sub_up
	btst.l	#0,d1
	beq.s	_dpmul_sub_pack
_dpmul_sub_up:
	addq.l	#1,d1
	bcc.s	_dpmul_sub_pack
	addq.l	#1,d0
_dpmul_sub_pack:
	btst.l	#20,d0			; carried up to the min normal?
	beq.s	_dpmul_sub_store
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	moveq	#1,d6
	INSERT_DBL_EXP d6
	or.l	d6,d0
	bra.s	_dpmul_sub_sign
_dpmul_sub_store:
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0 ; subnormal mantissa (exp field 0)
_dpmul_sub_sign:
	move.l	a0,d6
	or.l	d6,d0

_dpmul_done:
	movem.l	(sp)+,d2-d7/a0-a2
	unlk	a6
	rts

_dpmul_round_dir:
	; D4 directed normal round: inexact (d6 != 0), sign a0, mantissa d0:d1.
	movem.l	d0-d1,-(sp)		; save mantissa (movem preserves CCR on restore)
	move.l	a0,d1			; sign -> d1
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = round-up
	tst.l	d0
	movem.l	(sp)+,d0-d1		; restore mantissa (CCR unchanged)
	beq	_dpmul_pack
	bra	_dpmul_roundup

_dpmul_sub_dir:
	; D4 directed subnormal round: inexact, sign a0, mantissa d0:d1.
	movem.l	d0-d1,-(sp)
	move.l	a0,d1
	moveq	#1,d0
	bsr	_fe_dirup
	tst.l	d0
	movem.l	(sp)+,d0-d1
	beq	_dpmul_sub_pack
	bra	_dpmul_sub_up

_dpmul_zero:
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d6
	or.l	d6,d0			; signed zero
	bra.s	_dpmul_done

_dpmul_underflow:
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status ; D1: tiny nonzero product -> 0
	move.l	a0,d1			; sign
	moveq	#1,d0			; inexact (tiny nonzero)
	bsr	_fe_dirup		; RU-of-pos / RD-of-neg -> up to min subnormal
	tst.l	d0
	beq.s	_dpmul_unf_zero
	move.l	a0,d0
	andi.l	#$80000000,d0		; sign | 0 (hi)
	moveq	#1,d1			; min-subnormal lo = 1
	bra	_dpmul_done
_dpmul_unf_zero:
	moveq	#0,d0
	moveq	#0,d1
	move.l	a0,d6
	or.l	d6,d0			; signed zero
	bra	_dpmul_done

_dpmul_overflow:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status ; D1: overflow implies inexact
	move.l	a0,d1
	andi.l	#$80000000,d1		; sign
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf ; d1 = sign
	tst.l	d0
	bne.s	_dpmul_ovf_max
	move.l	d1,d0
	ori.l	#DBL_INF_HI,d0
	moveq	#0,d1
	bra	_dpmul_done
_dpmul_ovf_max:
	move.l	d1,d0
	ori.l	#$7FEFFFFF,d0		; signed max-finite (hi)
	moveq	#-1,d1			; max-finite lo = 0xFFFFFFFF
	bra	_dpmul_done

_dpmul_a_special:
	; a is inf or NaN
	move.l	DBL_ARG1_HI(a6),d0
	move.l	DBL_ARG1_LO(a6),d1
	move.l	d0,d2
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d1,d2
	bne	_dpmul_ret_nan		; a is NaN
	; a is inf: b zero -> NaN, b NaN -> NaN, else signed inf
	move.l	DBL_ARG2_HI(a6),d2
	move.l	DBL_ARG2_LO(a6),d3
	move.l	d2,d4
	andi.l	#$7FFFFFFF,d4
	or.l	d3,d4
	beq	_dpmul_invalid		; inf * 0 = NaN (invalid)
	move.l	d2,d4
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	cmpi.l	#IEEE754_DBL_EXP_MASK_HI,d4
	bne.s	_dpmul_inf		; b finite -> inf
	move.l	d2,d4
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d4
	or.l	d3,d4
	bne	_dpmul_ret_nan		; b is NaN -> NaN
_dpmul_inf:
	move.l	#DBL_INF_HI,d0
	moveq	#0,d1
	move.l	a0,d2
	or.l	d2,d0			; apply sign
	bra	_dpmul_done

_dpmul_b_special:
	; a is finite (a_special not taken); b is inf or NaN
	move.l	DBL_ARG2_HI(a6),d0
	move.l	DBL_ARG2_LO(a6),d1
	move.l	d0,d2
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	or.l	d1,d2
	bne	_dpmul_ret_nan		; b is NaN
	; b is inf: a zero -> NaN, else signed inf
	move.l	DBL_ARG1_HI(a6),d2
	move.l	DBL_ARG1_LO(a6),d3
	move.l	d2,d4
	andi.l	#$7FFFFFFF,d4
	or.l	d3,d4
	beq	_dpmul_invalid		; 0 * inf = NaN (invalid)
	bra.s	_dpmul_inf

_dpmul_invalid:
	ori.l	#FE_INVALID,_fe_status	; D1: 0*inf (signaled invalid)
_dpmul_ret_nan:
	move.l	#DBL_QNAN_HI,d0
	move.l	#DBL_QNAN_LO,d1
	bra	_dpmul_done

	end
