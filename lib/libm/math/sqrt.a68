	title	"IEEE 754 single-precision square root"
; ============================================================
;  _sqrt / _sqrtf — single-precision square root
;
;  float _sqrt(float x) — returns sqrt(x) in D0
;  Uses Newton-Raphson iteration: y = (y + x/y) / 2
;  Initial estimate from halving the exponent.
;  5 iterations for full single-precision accuracy.
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_sqrtf
	extern	_fpadd, _fpdiv, _fpmult
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round		; D4 directed rounding mode

	.code

_sqrtf:
	link	a6,#0
	movem.l	d2-d7,-(sp)

	; D1: save the caller's sticky flags.  The Newton iteration calls the core
	; ops (which now raise flags), so their pollution is discarded at exit and
	; only sqrt's own flags are raised: INVALID for x<0, INEXACT if x is not a
	; perfect square.
	move.l	_fe_status,d0
	move.l	d0,sqrt_fe
	clr.l	sqrt_flags
	; D4: run the Newton iteration in round-to-nearest; the final residual test
	; applies the caller's directed mode (sqrt is positive: RZ=RD=floor, RU=ceil).
	move.l	_fe_round,d0
	move.l	d0,sqrt_rmode
	clr.l	_fe_round

	move.l	8(a6),d2		; d2 = x

	; Handle zero
	move.l	d2,d0
	andi.l	#$7FFFFFFF,d0
	beq	_sqrt_zero

	; Handle negative → NaN
	tst.l	d2
	bmi	_sqrt_nan

	; Handle infinity
	cmpi.l	#SNG_INF,d2
	beq	_sqrt_inf

	; --- Subnormal input (D3): pre-scale to a normal value ---
	;  x is subnormal (exp field 0, mantissa != 0; zero handled above).
	;  Normalise the significand up to bit 23 and multiply by 2^152 so the
	;  operand is normal; sqrt(x) = sqrt(x*2^152) * 2^-76 (both are exact
	;  powers of two, so the correctly-rounded sqrt(x*2^152) yields the
	;  correctly-rounded sqrt(x)).  Record the -76 field adjustment.
	clr.l	sqrt_dn			; default: input already normal
	move.l	d2,d0
	andi.l	#$7F800000,d0
	bne.s	_sqrt_est		; normal input -> straight to the estimate
	move.l	d2,d0
	andi.l	#$007FFFFF,d0		; subnormal significand (no implied bit)
	moveq	#0,d1			; shift count s
_sqrt_sub_shl:
	addq.l	#1,d1
	lsl.l	#1,d0
	btst	#23,d0
	beq.s	_sqrt_sub_shl		; stop once the leading 1 reaches bit 23
	move.l	#153,d3
	sub.l	d1,d3			; exp field = 153 - s  (130..152)
	lsl.l	#8,d3
	lsl.l	#8,d3
	lsl.l	#7,d3			; << 23
	andi.l	#$007FFFFF,d0		; drop the implied bit
	or.l	d3,d0
	move.l	d0,d2			; d2 = x * 2^152 (normal)
	moveq	#76,d0
	move.l	d0,sqrt_dn		; result exponent field must drop by 76

_sqrt_est:
	; --- Initial estimate: halve the exponent ---
	; y0 = reinterpret((ieee + (127 << 23)) >> 1)
	; This is the "fast inverse sqrt" trick adapted for sqrt
	move.l	d2,d0
	lsr.l	#1,d0			; halve all bits
	addi.l	#$1FC00000,d0		; adjust bias: (127/2) << 23
	move.l	d0,d3			; d3 = y (current estimate)

	; --- Newton-Raphson: y = (y + x/y) * 0.5 ---
	; 5 iterations
	moveq	#5,d0
	move.l	d0,-(sp)		; save iteration count
	addq.l	#4,sp			; ... actually just use a counter

	moveq	#4,d0			; 5 iterations (0-4)
_sqrt_iter:
	move.l	d0,-(sp)		; save counter

	; Compute x / y
	move.l	d3,-(sp)		; push y (divisor)
	move.l	d2,-(sp)		; push x (dividend)
	jsr	_fpdiv
	addq.l	#8,sp			; d0 = x/y

	; Compute y + x/y
	move.l	d0,-(sp)		; push x/y
	move.l	d3,-(sp)		; push y
	jsr	_fpadd
	addq.l	#8,sp			; d0 = y + x/y

	; Multiply by 0.5
	move.l	#SNG_HALF,-(sp)		; push 0.5
	move.l	d0,-(sp)		; push (y + x/y)
	jsr	_fpmult
	addq.l	#8,sp			; d0 = (y + x/y) * 0.5

	move.l	d0,d3			; d3 = new y

	move.l	(sp)+,d0		; restore counter
	subq.l	#1,d0
	bpl.s	_sqrt_iter

	; ============================================================
	;  Correctly-round the Newton estimate (d3 = y, within 1 ULP)
	;  via an EXACT residual test on the significands (BUG-0012 fix):
	;  y is correctly rounded iff (2Ys-1)^2 <= Xs<<(k+2) <= (2Ys+1)^2,
	;  where k = Xe - 2Ye + 150 (biased exp fields).  Ties round to even.
	;  x is normal here (subnormal inputs were pre-scaled above).
	; ============================================================
	move.l	d2,d0
	andi.l	#$7F800000,d0
	beq	sqrt_result		; x subnormal (defensive) -> skip
	move.l	d3,d0
	andi.l	#$7F800000,d0
	beq	sqrt_result		; y subnormal / 0 -> skip
	cmpi.l	#$7F800000,d0
	beq	sqrt_result		; y inf -> skip

	; ye_f = exp field of y
	move.l	d3,d0
	lsr.l	#8,d0
	lsr.l	#8,d0
	lsr.l	#7,d0
	andi.l	#$FF,d0
	move.l	d0,ye_f
	move.l	d0,d5			; d5 = Ye field
	; d7 = exp field of x
	move.l	d2,d7
	lsr.l	#8,d7
	lsr.l	#8,d7
	lsr.l	#7,d7
	andi.l	#$FF,d7
	; d1 = k + 2 = (Xe - 2*Ye + 150) + 2
	add.l	d5,d5			; 2*Ye
	move.l	d7,d1
	sub.l	d5,d1
	addi.l	#152,d1			; d1 = shift count (k+2)
	; XX = Xs << (k+2)  -> xx_hi:xx_lo
	move.l	d2,d0
	andi.l	#$007FFFFF,d0
	ori.l	#$00800000,d0		; Xs (24-bit)
	moveq	#0,d4			; hi
sqrt_shl:
	lsl.l	#1,d0
	roxl.l	#1,d4
	subq.l	#1,d1
	bne.s	sqrt_shl
	move.l	d0,xx_lo
	move.l	d4,xx_hi
	; Ys in d6
	move.l	d3,d6
	andi.l	#$007FFFFF,d6
	ori.l	#$00800000,d6		; Ys (24-bit)
	; --- INEXACT (D1): sqrt is exact iff XX == (2Ys)^2 (x a perfect square) ---
	move.l	d6,d0
	add.l	d0,d0			; 2Ys
	bsr	sqrt_sqr25		; d0:d1 = (2Ys)^2  (preserves d5/d6)
	move.l	xx_lo,d4
	move.l	xx_hi,d5
	sub.l	d1,d4			; XX - (2Ys)^2
	subx.l	d0,d5
	move.l	d5,d0
	or.l	d4,d0
	beq.s	sqrt_is_exact
	ori.l	#FE_INEXACT,sqrt_flags
sqrt_is_exact:
	tst.l	sqrt_rmode
	bne	sqrt_dir		; D4 directed rounding (uses D = XX-(2Ys)^2)
	; --- upper bound U = (2Ys+1)^2 ---
	move.l	d6,d0
	add.l	d0,d0
	addq.l	#1,d0			; 2Ys+1
	bsr	sqrt_sqr25		; d0:d1 = hi:lo(U)
	move.l	xx_lo,d4
	move.l	xx_hi,d5
	sub.l	d1,d4			; XX - U (64-bit)
	subx.l	d0,d5
	tst.l	d5
	bmi	sqrt_below_u		; XX < U
	move.l	d5,d0
	or.l	d4,d0
	beq	sqrt_tie_up		; XX == U (half-way to y+1)
	bra	sqrt_inc		; XX > U
sqrt_tie_up:
	btst	#0,d6			; round to even
	bne	sqrt_inc
	bra	sqrt_keep
sqrt_below_u:
	cmpi.l	#$00800000,d6		; result mantissa a power of two?
	beq.s	sqrt_below_pow2
	; --- normal lower bound L = (2Ys-1)^2 vs XX ---
	move.l	d6,d0
	add.l	d0,d0
	subq.l	#1,d0			; 2Ys-1
	bsr	sqrt_sqr25		; d0:d1 = hi:lo(L)
	move.l	xx_lo,d4
	move.l	xx_hi,d5
	sub.l	d1,d4			; XX - L
	subx.l	d0,d5
	bra.s	sqrt_low_test
sqrt_below_pow2:
	; power-of-two result: the lower neighbour has HALF the ULP, so the
	; lower mid-point is (4Ys-1)^2 compared against XX<<2 (a finer grid).
	move.l	xx_lo,d4
	move.l	xx_hi,d5
	lsl.l	#1,d4
	roxl.l	#1,d5
	lsl.l	#1,d4
	roxl.l	#1,d5			; XX << 2
	move.l	d6,d0
	lsl.l	#2,d0			; 4Ys
	subq.l	#1,d0			; 4Ys-1
	bsr	sqrt_sqr25		; d0:d1 = hi:lo(L)
	sub.l	d1,d4			; XX<<2 - L
	subx.l	d0,d5
sqrt_low_test:
	tst.l	d5
	bmi	sqrt_dec		; XX < L -> decrement
	move.l	d5,d0
	or.l	d4,d0
	beq	sqrt_tie_down		; XX == L (half-way to y-1)
	bra	sqrt_keep		; L < XX < U -> y is correct
sqrt_tie_down:
	btst	#0,d6
	bne	sqrt_dec
	bra	sqrt_keep
sqrt_inc:
	addq.l	#1,d6
	cmpi.l	#$01000000,d6
	bcs.s	sqrt_keep		; still < 2^24
	lsr.l	#1,d6			; 0x1000000 -> 0x800000, bump exponent
	addq.l	#1,ye_f
	bra.s	sqrt_keep
sqrt_dec:
	subq.l	#1,d6
	cmpi.l	#$00800000,d6
	bcc.s	sqrt_keep		; still >= 2^23
	move.l	#$00FFFFFF,d6		; 0x7FFFFF -> 0xFFFFFF, drop exponent
	subq.l	#1,ye_f
	bra.s	sqrt_keep
sqrt_dir:
	; D4 directed: d5:d4 = D = XX - (2Ys)^2.  D==0 exact; D>0 true>y; D<0 true<y.
	; sqrt >= 0: RZ(1)/RD(3) = floor, RU(2) = ceil.
	move.l	d5,d0
	or.l	d4,d0
	beq	sqrt_keep		; exact -> keep y
	tst.l	d5			; sign of D
	bmi.s	sqrt_dir_below
	cmpi.l	#2,sqrt_rmode		; D > 0 (true in (y,y+1)): RU -> inc, else keep
	beq	sqrt_inc
	bra	sqrt_keep
sqrt_dir_below:
	cmpi.l	#2,sqrt_rmode		; D < 0 (true in (y-1,y)): RU -> keep, else dec
	beq	sqrt_keep
	bra	sqrt_dec
sqrt_keep:
	move.l	ye_f,d0
	lsl.l	#8,d0
	lsl.l	#8,d0
	lsl.l	#7,d0			; Ye field << 23
	move.l	d6,d1
	andi.l	#$007FFFFF,d1		; mantissa (drop implicit bit)
	or.l	d1,d0
	move.l	d0,d3			; corrected result (positive)
sqrt_result:
	move.l	d3,d0			; result
	; --- Undo the subnormal pre-scale (D3): multiply by 2^-76 ---
	move.l	sqrt_dn,d1
	beq.s	_sqrt_done		; input was normal, nothing to undo
	lsl.l	#8,d1
	lsl.l	#8,d1
	lsl.l	#7,d1			; dn << 23
	sub.l	d1,d0			; result exp field -= 76 (stays normal)

_sqrt_done:
	move.l	sqrt_fe,d1		; D1: restore caller flags | sqrt's own flags
	or.l	sqrt_flags,d1
	move.l	d1,_fe_status
	move.l	sqrt_rmode,_fe_round	; D4: restore the directed mode
	movem.l	(sp)+,d2-d7
	unlk	a6
	rts

; sqrt_sqr25 -- D0 = A (<= 25 bits) -> D0:D1 = hi:lo of A*A.  Clobbers D0/D1.
sqrt_sqr25:
	movem.l	d2-d4,-(sp)
	move.l	d0,d2
	andi.l	#$FFFF,d2		; Al
	move.l	d0,d3
	clr.w	d3
	swap	d3			; Ah = A >> 16
	move.l	d2,d0
	mulu	d2,d0			; Al^2         (lo accumulator)
	move.l	d3,d1
	mulu	d3,d1			; Ah^2         (hi accumulator)
	move.l	d3,d4
	mulu	d2,d4			; Ah*Al
	add.l	d4,d4			; 2*Ah*Al
	move.l	d4,d2
	swap	d2			; d2.w = (2AhAl)>>16 ; upper word = (2AhAl)&FFFF
	moveq	#0,d3
	move.w	d2,d3			; d3 = (2AhAl) >> 16
	clr.w	d2			; d2 = ((2AhAl)&FFFF) << 16
	add.l	d2,d0			; lo += low cross term
	addx.l	d3,d1			; hi += high cross term + carry
	exg	d0,d1			; d0 = hi, d1 = lo
	movem.l	(sp)+,d2-d4
	rts

_sqrt_zero:
	move.l	d2,d0			; return original ±0
	bra	_sqrt_done

_sqrt_nan:
	; sign bit set: negative finite / -inf -> INVALID; a (negative) NaN input
	; just propagates (no INVALID -- sNaN is D6).
	move.l	d2,d0
	andi.l	#$7F800000,d0
	cmpi.l	#$7F800000,d0		; exp all-ones?
	bne.s	_sqrt_nan_inv		; finite negative -> invalid
	move.l	d2,d0
	andi.l	#$007FFFFF,d0
	bne.s	_sqrt_nan_ret		; NaN input -> propagate (no flag)
_sqrt_nan_inv:
	ori.l	#FE_INVALID,sqrt_flags	; sqrt(negative) / sqrt(-inf)
_sqrt_nan_ret:
	move.l	#SNG_QNAN,d0
	bra	_sqrt_done

_sqrt_inf:
	move.l	#SNG_INF,d0		; sqrt(+inf) = +inf
	bra	_sqrt_done

	.bss
ye_f		ds.l	1		; result exponent field (mutable during rounding)
xx_hi		ds.l	1		; 4 * Xs << k  (64-bit)
xx_lo		ds.l	1
sqrt_dn		ds.l	1		; subnormal-input scale-down (0 or 76)
sqrt_fe		ds.l	1		; D1: saved caller _fe_status
sqrt_flags	ds.l	1		; D1: sqrt's own raised flags
sqrt_rmode	ds.l	1		; D4: saved directed rounding mode

	end
