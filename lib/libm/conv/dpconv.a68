	title	"IEEE 754 single/double/integer conversions"
; ============================================================
;  _fpftod — single → double (widen)
;  _fpdtof — double → single (narrow)
;  _fpltod — int32 → double
;  _fpdtol — double → int32 (truncate)
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpftod, _fpdtof, _fpltod, _fpdtol
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup, _fe_ovf_maxf	; D4 directed rounding

	.code

; ============================================================
;  _fpftod — single to double (lossless widening)
;
;  Input:  4(sp) = IEEE 754 single
;  Output: D0:D1 = IEEE 754 double (D0=high, D1=low)
; ============================================================
_fpftod:
	move.l	4(sp),d0		; original single
	move.l	d0,d1
	andi.l	#$7FFFFFFF,d1
	beq.s	_ftod_zero		; +/-0 -> signed zero double

	movem.l	d2,-(sp)

	move.l	d0,d1
	andi.l	#IEEE754_SNG_SIGN_MASK,d1 ; d1 = sign bit

	move.l	d0,d2
	andi.l	#IEEE754_SNG_EXP_MASK,d2
	EXTRACT_EXP d2			; d2 = sng exponent
	beq.s	_ftod_subnormal		; exp field 0 -> subnormal single (D3)
	cmpi.l	#255,d2
	beq.s	_ftod_inf_nan		; inf/NaN -> double exp all-ones
	addi.l	#896,d2			; dbl exponent = sng_exp + 896
_ftod_exp_ready:
	INSERT_DBL_EXP d2		; d2 = positioned double exponent
	or.l	d1,d2			; d2 = sign | exp (high word so far)

	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; d0 = 23-bit mantissa

	; Split mantissa: upper 20 bits → high word, lower 3 → low word
	move.l	d0,d1			; save for low word
	lsr.l	#3,d0			; upper 20 bits
	or.l	d2,d0			; d0 = sign | exp | mant_hi (high word)

	andi.l	#7,d1			; lower 3 bits
	; shift left 29: 8+8+8+5
	lsl.l	#8,d1
	lsl.l	#8,d1
	lsl.l	#8,d1
	lsl.l	#5,d1			; d1 = low word

	movem.l	(sp)+,d2
	rts

_ftod_inf_nan:
	move.l	#2047,d2		; double exponent all-ones
	bra.s	_ftod_exp_ready

_ftod_zero:
	move.l	4(sp),d0
	andi.l	#IEEE754_SNG_SIGN_MASK,d0 ; signed zero (sign in bit 31)
	moveq	#0,d1
	rts

_ftod_subnormal:
	; single subnormal (D3): value = mant*2^-149, a NORMAL double.
	; normalise the significand to bit 23; dbl exp field = 897 - s.
	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; 23-bit mantissa (nonzero)
	move.l	#897,d2			; base exponent field
_ftod_sub_shl:
	subq.l	#1,d2
	lsl.l	#1,d0
	btst	#23,d0
	beq.s	_ftod_sub_shl		; stop when the leading 1 reaches bit 23
	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; drop the implied bit
	bra.s	_ftod_exp_ready		; d2 = dbl exp field, d0 = fraction, d1 = sign

; ============================================================
;  _fpdtof — double to single (narrow)
;
;  Input:  4(sp)=high, 8(sp)=low
;  Output: D0 = IEEE 754 single
; ============================================================
_fpdtof:
	move.l	4(sp),d0		; double high
	move.l	8(sp),d1		; double low
	movem.l	d2-d3,-(sp)

	move.l	d0,d2			; d2 = high (save)
	move.l	d1,d3			; d3 = low (save)

	; Handle zero
	move.l	d0,d1
	andi.l	#$7FFFFFFF,d1
	or.l	d3,d1
	bne.s	_dtof_nonzero
	andi.l	#IEEE754_SNG_SIGN_MASK,d0 ; preserve sign of zero
	movem.l	(sp)+,d2-d3
	rts

_dtof_nonzero:
	; Sign
	move.l	d2,d0
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d0 ; d0 = sign

	; Exponent
	move.l	d2,d1
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d1
	EXTRACT_DBL_EXP d1
	subi.l	#896,d1
	ble.s	_dtof_underflow
	cmpi.l	#255,d1
	bge	_dtof_overflow

	; Pack exponent
	INSERT_EXP d1
	or.l	d1,d0

	; Mantissa: 20 bits from high + 3 bits from low
	move.l	d2,d1
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d1 ; 20 bits
	lsl.l	#3,d1			; shift left 3
	move.l	d3,d2			; low word
	rol.l	#3,d2			; rotate top 3 bits to bottom
	andi.l	#7,d2
	or.l	d2,d1			; d1 = 23-bit mantissa
	or.l	d1,d0			; combine (d0 = sign|exp|mant, pre-round)

	; --- round to nearest even (BUG-0018) using the 29 dropped low-word bits ---
	; guard = bit 28 of the low word (d3); sticky = bits 27:0; lsb = mant bit 0.
	; +1 on the packed single carries mantissa->exponent->inf correctly.
	; D1: INEXACT if any of the 29 dropped bits (d3 bits 28:0) is set.
	move.l	d3,d1
	andi.l	#$1FFFFFFF,d1
	beq.s	_dtof_exact
	ori.l	#FE_INEXACT,_fe_status
_dtof_exact:
	tst.l	_fe_round
	bne	_dtof_rdir		; D4 directed rounding
	btst	#28,d3
	beq.s	_dtof_rounded		; guard=0 -> truncate (round down)
	move.l	d3,d1
	andi.l	#$0FFFFFFF,d1		; sticky = low-word bits 27:0
	bne.s	_dtof_roundup		; > half -> round up
	btst	#0,d0			; exactly half -> round to even
	beq.s	_dtof_rounded		;   mantissa even -> stay
_dtof_roundup:
	addq.l	#1,d0			; round up 1 ULP
	move.l	d0,d1
	andi.l	#$7F800000,d1
	cmpi.l	#$7F800000,d1		; round-up carried a finite -> inf?
	bne.s	_dtof_rounded
	ori.l	#FE_OVERFLOW,_fe_status	; D1: overflow (INEXACT already set)
_dtof_rounded:
	movem.l	(sp)+,d2-d3
	rts

_dtof_rdir:
	; D4 directed normal round: inexact = d3 bits 28:0, sig d0 (sign in bit31).
	move.l	d3,d1
	andi.l	#$1FFFFFFF,d1
	beq	_dtof_rounded		; exact -> truncate
	movem.l	d0,-(sp)		; save sig
	move.l	d0,d1
	andi.l	#$80000000,d1		; sign
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = round-up
	tst.l	d0
	movem.l	(sp)+,d0		; restore sig (CCR unchanged)
	beq	_dtof_rounded
	bra	_dtof_roundup

_dtof_underflow:
	; D3 gradual underflow: narrow to a subnormal single (was FTZ -> 0).
	; d0 = sign(bit31), d1 = F (would-be single exp field, <= 0),
	; d2 = dbl hi, d3 = dbl lo.  Result = round(S >> shift_r) on the
	; subnormal grid, shift_r = 30 - F (>= 30); a round-up to 2^23 becomes
	; the min normal automatically (bit 23 -> exp field 1).
	neg.l	d1
	addi.l	#30,d1			; d1 = shift_r
	cmpi.l	#54,d1
	bge.s	_dtof_sub_zero		; < half the min subnormal -> signed zero
	movem.l	d4-d5,-(sp)
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d2
	ori.l	#$00100000,d2		; d2:d3 = 53-bit significand (implied bit at hi bit 20)
	moveq	#0,d4			; sticky
	moveq	#0,d5			; guard (last bit shifted out)
_dtof_sub_shr:
	or.l	d5,d4			; fold previous guard into sticky
	move.l	d3,d5
	andi.l	#1,d5			; new guard = bit about to leave
	lsr.l	#1,d2
	roxr.l	#1,d3			; [d2:d3] >>= 1
	subq.l	#1,d1
	bne.s	_dtof_sub_shr
	; d3 = frac (<=23 bits), d5 = guard, d4 = sticky
	tst.l	_fe_round
	bne	_dtof_sub_dir		; D4 directed rounding
	tst.l	d5
	beq.s	_dtof_sub_pack		; guard 0 -> truncate
	tst.l	d4
	bne.s	_dtof_sub_up		; sticky != 0 -> round up
	btst	#0,d3			; exactly half -> round to even
	beq.s	_dtof_sub_pack
_dtof_sub_up:
	addq.l	#1,d3			; +1 ULP (frac may reach 2^23 = min normal)
_dtof_sub_pack:
	move.l	d5,d1			; D1: inexact = guard | sticky (tininess-before)
	or.l	d4,d1
	beq.s	_dtof_sub_pk
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status
_dtof_sub_pk:
	or.l	d3,d0			; sign | frac
	movem.l	(sp)+,d4-d5
	movem.l	(sp)+,d2-d3
	rts
_dtof_sub_zero:
	ori.l	#FE_UNDERFLOW+FE_INEXACT,_fe_status ; tiny nonzero double -> 0
	move.l	d0,d1			; D4: sign -> d1 (preserved by helper)
	moveq	#1,d0			; inexact (tiny nonzero)
	bsr	_fe_dirup		; RU-of-pos / RD-of-neg -> min subnormal
	tst.l	d0
	beq.s	_dtof_sz_zero
	move.l	d1,d0
	andi.l	#$80000000,d0
	ori.l	#1,d0			; sign | min-subnormal
	movem.l	(sp)+,d2-d3
	rts
_dtof_sz_zero:
	move.l	d1,d0			; signed zero
	movem.l	(sp)+,d2-d3		; d0 already = sign -> signed zero
	rts

_dtof_sub_dir:
	; D4 directed subnormal round: inexact = d5|d4, sign d0 (bit31), frac d3.
	move.l	d5,d1
	or.l	d4,d1
	beq	_dtof_sub_pack		; exact -> truncate
	movem.l	d0,-(sp)		; save sign
	move.l	d0,d1			; sign (bit31)
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = up ; d3 (frac) preserved
	tst.l	d0
	movem.l	(sp)+,d0		; restore sign
	beq	_dtof_sub_pack
	bra	_dtof_sub_up

_dtof_overflow:
	; double exp >= 255 in single terms: NaN -> single NaN, else signed inf
	move.l	d2,d1
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d1
	cmpi.l	#IEEE754_DBL_EXP_MASK_HI,d1
	bne.s	_dtof_ovf_finite	; finite overflow -> inf + OVERFLOW (D1)
	move.l	d2,d1
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d1
	or.l	d3,d1
	beq.s	_dtof_ovf_inf		; inf -> single inf (no flag)
	move.l	#SNG_QNAN,d0		; NaN -> single qNaN (no flag)
	movem.l	(sp)+,d2-d3
	rts
_dtof_ovf_finite:
	ori.l	#FE_OVERFLOW+FE_INEXACT,_fe_status ; finite -> inf: overflow + inexact
	move.l	d2,d1
	andi.l	#$80000000,d1		; single sign
	bsr	_fe_ovf_maxf		; d0 = 1 max-finite / 0 inf ; d1 = sign
	tst.l	d0
	beq.s	_dtof_ovf_inf
	move.l	d1,d0
	ori.l	#$7F7FFFFF,d0		; directed toward 0 -> max-finite
	movem.l	(sp)+,d2-d3
	rts
_dtof_ovf_inf:
	move.l	#SNG_INF,d0
	move.l	d2,d1
	andi.l	#IEEE754_SNG_SIGN_MASK,d1
	or.l	d1,d0
	movem.l	(sp)+,d2-d3
	rts

; ============================================================
;  _fpltod — int32 to double
;
;  Input:  4(sp) = int32
;  Output: D0:D1 = IEEE 754 double
; ============================================================
_fpltod:
	move.l	4(sp),d0		; integer
	beq.s	_ltod_zero

	movem.l	d2-d4,-(sp)
	moveq	#0,d2			; sign
	tst.l	d0
	bpl.s	_ltod_pos
	neg.l	d0
	move.l	#IEEE754_DBL_SIGN_MASK_HI,d2
_ltod_pos:
	move.l	#1023+31,d3		; exponent (assuming MSB at bit 31)
_ltod_norm:
	btst.l	#31,d0
	bne.s	_ltod_pack
	lsl.l	#1,d0
	subq.l	#1,d3
	bra.s	_ltod_norm

_ltod_pack:
	; d0 = normalized value (bit 31 = implied 1)
	; d3 = biased exponent
	; d2 = sign
	; Need: high word = sign | exp | mantissa[30:11]
	;        low word = mantissa[10:0] << 21

	move.l	d0,d4			; save for low word
	lsr.l	#8,d0
	lsr.l	#3,d0			; d0 >>= 11: bits 30..11 → bits 19..0
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0

	move.l	d3,d1			; exponent
	INSERT_DBL_EXP d1
	or.l	d1,d0			; add exponent
	or.l	d2,d0			; add sign

	; Low word: bits 10..0 of normalized value → bits 31..21
	move.l	d4,d1
	andi.l	#$7FF,d1		; lower 11 bits
	lsl.l	#8,d1
	lsl.l	#8,d1
	lsl.l	#5,d1			; << 21

	movem.l	(sp)+,d2-d4
	rts

_ltod_zero:
	moveq	#0,d0
	moveq	#0,d1
	rts

; ============================================================
;  _fpdtol — double to int32 (truncate toward zero)
;
;  Input:  4(sp)=high, 8(sp)=low
;  Output: D0 = int32
;
;  Saturation (out-of-range / inf / NaN): positive -> INT_MAX $7FFFFFFF,
;  negative -> INT_MIN $80000000; x == -2^31 exactly is in range (INT_MIN).
;  D1 flags: FE_INVALID on a saturated result; FE_INEXACT when truncation
;  discards a nonzero fraction (including 0 < |x| < 1 -> 0).
; ============================================================
_fpdtol:
	move.l	4(sp),d0		; high
	move.l	8(sp),d1		; low
	movem.l	d2-d5,-(sp)		; d5 = fraction-sticky scratch

	; Sign
	move.l	d0,d2
	andi.l	#IEEE754_DBL_SIGN_MASK_HI,d2

	; Exponent
	move.l	d0,d3
	andi.l	#IEEE754_DBL_EXP_MASK_HI,d3
	EXTRACT_DBL_EXP d3

	; |x| < 1 -> 0 (INEXACT unless exactly +/-0)
	cmpi.l	#IEEE754_DBL_EXP_BIAS,d3
	blt	_dtol_zero

	; Out of range: exp > 1054 -> inf / NaN / |x| >= 2^32 (INVALID)
	cmpi.l	#1023+31,d3
	bgt	_dtol_overflow
	beq	_dtol_boundary		; exp == 1054: in range only for x == -2^31

	; Mantissa with implied bit
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	ori.l	#IEEE754_DBL_IMPLIED_BIT_HI,d0

	; Unbiased exponent (0..30)
	subi.l	#IEEE754_DBL_EXP_BIAS,d3

	cmpi.l	#20,d3
	bgt.s	_dtol_large_exp

	; exp <= 20: integer is in d0; fraction = low (20-exp) bits of d0 + all of d1
	move.l	#20,d4
	sub.l	d3,d4			; d4 = 20 - exp
	moveq	#1,d5
	lsl.l	d4,d5
	subq.l	#1,d5			; d5 = (1<<(20-exp))-1
	and.l	d0,d5			; low fraction bits of d0
	or.l	d1,d5			; | lo word -> d5 = sticky
	lsr.l	d4,d0
	bra.s	_dtol_frac_done

_dtol_large_exp:
	; exp > 20: combine bits from d0 and d1; fraction = low (52-exp) bits of d1
	move.l	d3,d4
	subi.l	#20,d4			; d4 = exp - 20 (1..10)
	move.l	#32,d3
	sub.l	d4,d3			; d3 = 32 - (exp-20) = 52 - exp
	moveq	#1,d5
	lsl.l	d3,d5
	subq.l	#1,d5			; d5 = (1<<(52-exp))-1
	and.l	d1,d5			; d5 = dropped low bits of d1 (sticky)
	lsr.l	d3,d1			; d1 = upper (exp-20) bits
	lsl.l	d4,d0			; shift mantissa high left
	or.l	d1,d0			; combine

_dtol_frac_done:
	tst.l	d5
	beq.s	_dtol_apply_sign
	ori.l	#FE_INEXACT,_fe_status

_dtol_apply_sign:
	tst.l	d2
	beq.s	_dtol_done
	neg.l	d0

_dtol_done:
	movem.l	(sp)+,d2-d5
	rts

_dtol_zero:
	; |x| < 1: result 0; INEXACT unless x is exactly +/-0
	andi.l	#$7FFFFFFF,d0
	or.l	d1,d0			; magnitude (hi-abs | lo)
	beq.s	_dtol_zero_exact
	ori.l	#FE_INEXACT,_fe_status
_dtol_zero_exact:
	moveq	#0,d0
	movem.l	(sp)+,d2-d5
	rts

_dtol_boundary:
	; exp == 1054 (|x| in [2^31,2^32)): in range only for x == -2^31 exactly
	tst.l	d2
	beq.s	_dtol_ovf_pos		; +2^31.. -> overflow
	andi.l	#IEEE754_DBL_MANT_MASK_HI,d0
	or.l	d1,d0			; any mantissa bit set?
	bne.s	_dtol_ovf_neg		; -(2^31+..) -> overflow
	move.l	#$80000000,d0		; exactly -2^31 = INT_MIN (in range, exact)
	movem.l	(sp)+,d2-d5
	rts

_dtol_overflow:
	tst.l	d2
	bne.s	_dtol_ovf_neg
_dtol_ovf_pos:
	move.l	#$7FFFFFFF,d0		; +overflow / +inf / +NaN -> INT_MAX
	ori.l	#FE_INVALID,_fe_status
	movem.l	(sp)+,d2-d5
	rts
_dtol_ovf_neg:
	move.l	#$80000000,d0		; -overflow / -inf / -NaN -> INT_MIN
	ori.l	#FE_INVALID,_fe_status
	movem.l	(sp)+,d2-d5
	rts

	end
