	title	"IEEE 754 integer to single-precision conversion"
; ============================================================
;  _fpltof — convert 32-bit signed integer to IEEE 754 single
;
;  float _fpltof(long x) — returns float(x) in D0
;  Argument: 4(SP) = signed 32-bit integer
;
;  Algorithm:
;    1. Handle zero
;    2. Record and remove sign
;    3. Count leading zeros to find exponent
;    4. Shift mantissa to position 23 (implied bit)
;    5. Pack sign + exponent + mantissa
; ============================================================

	.model	flat
	include	ieee754.inc

	public	_fpltof
	extern	_fe_status		; D1 sticky exception flags
	extern	_fe_round, _fe_dirup	; D4 directed rounding

	.code

_fpltof:
	move.l	4(sp),d0		; d0 = integer input
	beq.s	_ltof_zero		; zero → return 0.0

	movem.l	d1-d3,-(sp)		; save d1 (scratch) + d2/d3 (callee-saved)

	; Record sign
	moveq	#0,d2			; d2 = sign (0 = positive)
	tst.l	d0
	bpl.s	_ltof_pos
	neg.l	d0			; make positive
	move.l	#IEEE754_SNG_SIGN_MASK,d2
_ltof_pos:

	; Find the position of the highest set bit
	; Exponent = 127 + (bit_position)
	; Start with exponent for bit 31 and shift left counting
	move.l	#127+31,d1		; d1 = exponent if MSB is bit 31

_ltof_norm:
	btst.l	#31,d0			; is top bit set?
	bne.s	_ltof_pack
	lsl.l	#1,d0			; shift left
	subq.l	#1,d1			; decrement exponent
	bra.s	_ltof_norm

_ltof_pack:
	; d0 has the value with bit 31 as the implied bit.  The >>8 drops bits
	; 7:0; round them to nearest-even (guard = bit 7, sticky = bits 6:0).
	move.l	d0,d3
	andi.l	#$FF,d3			; d3 = guard + round bits
	beq.s	_ltof_exact
	ori.l	#FE_INEXACT,_fe_status	; D1: dropped bits -> inexact
_ltof_exact:
	lsr.l	#8,d0			; implied bit now at bit 23
	tst.l	_fe_round
	bne	_ltof_rdir		; D4 directed rounding
	cmpi.l	#$80,d3
	blo.s	_ltof_finish		; below half -> truncate
	bhi.s	_ltof_roundup		; above half -> round up
	btst.l	#0,d0			; exactly half -> round to even
	beq.s	_ltof_finish
_ltof_roundup:
	addq.l	#1,d0			; round up
	cmpi.l	#$1000000,d0		; mantissa carried out to 2^24?
	blo.s	_ltof_finish
	lsr.l	#1,d0			; renormalize
	addq.l	#1,d1			; bump exponent
_ltof_finish:
	andi.l	#IEEE754_SNG_MANT_MASK,d0 ; strip implied bit (bit 23)
	INSERT_EXP d1
	or.l	d1,d0			; combine exponent
	or.l	d2,d0			; combine sign

	movem.l	(sp)+,d1-d3
	rts

_ltof_zero:
	moveq	#0,d0
	rts

_ltof_rdir:
	; D4 directed: d3 = dropped bits (inexact), d0 = 24-bit sig, d1 = exponent,
	; d2 = sign (bit31).
	tst.l	d3
	beq	_ltof_finish		; exact -> truncate
	movem.l	d0-d1,-(sp)		; save sig AND exponent (d1)
	move.l	d2,d1			; sign
	moveq	#1,d0			; inexact
	bsr	_fe_dirup		; d0 = round-up
	tst.l	d0
	movem.l	(sp)+,d0-d1		; restore sig + exponent (CCR unchanged)
	beq	_ltof_finish
	bra	_ltof_roundup

	end
